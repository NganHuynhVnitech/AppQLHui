@model IEnumerable<AppQLHui.DTOs.PlayerNetBalanceDto>
@{
    ViewData["Title"] = "Sổ hụi - Báo cáo Âm/Dương";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>📈 Sổ hụi - Trạng thái Âm/Dương toàn bộ hụi viên</h4>
    <button onclick="window.print()" class="btn btn-outline-secondary no-print">🖨️ In sổ hụi</button>
</div>

<div class="row g-3 mb-3 no-print">
    <div class="col-md-4">
        <div class="card stat-card green p-3">
            <small class="text-muted">Tổng dương (còn nợ)</small>
            <div class="fw-bold text-success fs-5">@Model.Where(m => m.NetBalance > 0).Sum(m => m.NetBalance).ToString("N0") đ</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card p-3" style="border-left-color:#dc3545">
            <small class="text-muted">Tổng âm (đã rút nhiều hơn)</small>
            <div class="fw-bold text-danger fs-5">@Math.Abs(Model.Where(m => m.NetBalance < 0).Sum(m => m.NetBalance)).ToString("N0") đ</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card blue p-3">
            <small class="text-muted">Tổng hụi viên</small>
            <div class="fw-bold text-primary fs-5">@Model.Count() người</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Tên hụi viên</th>
                    <th>SĐT</th>
                    <th class="text-end">Hụi sống (chưa hốt)</th>
                    <th class="text-end">Hụi chết (đã hốt)</th>
                    <th class="text-end">Thảo đã nộp</th>
                    <th class="text-center">Trạng thái Âm/Dương</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    var isPositive = b.NetBalance >= 0;
                    var netClass = isPositive ? "text-positive" : "text-negative";
                    var badgeClass = isPositive ? "bg-success" : "bg-danger";
                    var badgeText = isPositive ? $"+{b.NetBalance.ToString("N0")} đ (Dương)" : $"{b.NetBalance.ToString("N0")} đ (Âm)";
                    <tr>
                        <td><strong>@b.PlayerName</strong></td>
                        <td>@b.Phone</td>
                        <td class="text-end">@b.TotalLivingAmount.ToString("N0") đ</td>
                        <td class="text-end">@b.TotalDeadAmount.ToString("N0") đ</td>
                        <td class="text-end text-muted">@b.TotalFeesPaid.ToString("N0") đ</td>
                        <td class="text-center">
                            <span class="badge @badgeClass">@badgeText</span>
                        </td>
                        <td>
                            <a asp-action="PlayerHistory" asp-route-playerId="@b.PlayerId"
                               class="btn btn-sm btn-outline-info no-print">Lịch sử</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3 no-print">
    <a asp-action="DailyBill" class="btn btn-outline-primary">📅 Bill theo ngày</a>
</div>
