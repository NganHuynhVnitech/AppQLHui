@model IEnumerable<AppQLHui.Models.Transaction>
@{
    ViewData["Title"] = "Lịch sử giao dịch";
    var player = (AppQLHui.Models.Player)ViewBag.Player;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>📜 Lịch sử giao dịch: @player.Name</h4>
    <a asp-action="Index" class="btn btn-outline-secondary">← Sổ hụi</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Ngày</th><th>Dây hụi</th><th>Kỳ</th>
                    <th class="text-end">Đóng</th>
                    <th class="text-end">Nhận</th>
                    <th class="text-end">Net</th>
                    <th>TT</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model)
                {
                    var nc = tx.NetTotal >= 0 ? "text-positive" : "text-negative";
                    <tr class="@(tx.AmountReceive > 0 ? "table-success" : "")">
                        <td>@tx.Draw.DrawDate.ToString("dd/MM/yyyy")</td>
                        <td>@tx.Draw.Tontine.Name</td>
                        <td>#@tx.Draw.SequenceNumber</td>
                        <td class="text-end">@(tx.AmountPay > 0 ? tx.AmountPay.ToString("N0")+" đ" : "-")</td>
                        <td class="text-end fw-bold text-success">@(tx.AmountReceive > 0 ? tx.AmountReceive.ToString("N0")+" đ" : "-")</td>
                        <td class="text-end @nc fw-bold">@(tx.NetTotal >= 0 ? "+" : "")@tx.NetTotal.ToString("N0") đ</td>
                        <td>@(tx.IsSettled ? "✅" : "⏳")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-bold table-secondary">
                <tr>
                    <td colspan="3">Tổng cộng</td>
                    <td class="text-end">@Model.Sum(t => t.AmountPay).ToString("N0") đ</td>
                    <td class="text-end">@Model.Sum(t => t.AmountReceive).ToString("N0") đ</td>
                    <td class="text-end @(Model.Sum(t=>t.NetTotal)>=0?"text-positive":"text-negative")">
                        @(Model.Sum(t=>t.NetTotal)>=0?"+":"")@Model.Sum(t => t.NetTotal).ToString("N0") đ
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
