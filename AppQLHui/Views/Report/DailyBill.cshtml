@model IEnumerable<AppQLHui.Models.Transaction>
@{
    ViewData["Title"] = "Bill đóng hụi theo ngày";
    var date = (DateTime)ViewBag.Date;
}

<div class="d-flex justify-content-between align-items-center mb-3 no-print">
    <h4>📅 Bill đóng hụi ngày @date.ToString("dd/MM/yyyy")</h4>
    <div class="d-flex gap-2">
        <form method="get" asp-action="DailyBill" class="d-flex gap-2">
            <input type="date" name="date" value="@date.ToString("yyyy-MM-dd")" class="form-control" />
            <button type="submit" class="btn btn-primary">Xem</button>
        </form>
        <button onclick="window.print()" class="btn btn-outline-secondary">🖨️ In</button>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có giao dịch nào vào ngày @date.ToString("dd/MM/yyyy").</div>
}
else
{
    @foreach (var grp in Model.GroupBy(t => t.Player.Name).OrderBy(g => g.Key))
    {
        <div class="card mb-3">
            <div class="card-header fw-bold">👤 @grp.Key</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Dây hụi</th><th>Kỳ</th>
                            <th class="text-end">Đóng</th>
                            <th class="text-end">Nhận</th>
                            <th class="text-end">Thực nhận</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in grp)
                        {
                            var nc = tx.NetTotal >= 0 ? "text-success" : "text-danger";
                            <tr>
                                <td>@tx.Draw.Tontine.Name</td>
                                <td>#@tx.Draw.SequenceNumber</td>
                                <td class="text-end">@(tx.AmountPay > 0 ? tx.AmountPay.ToString("N0")+" đ" : "-")</td>
                                <td class="text-end text-success">@(tx.AmountReceive > 0 ? tx.AmountReceive.ToString("N0")+" đ" : "-")</td>
                                <td class="text-end @nc fw-bold">@(tx.NetTotal >= 0 ? "+" : "")@tx.NetTotal.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="fw-bold table-secondary">
                        @{
                            var totalNet = grp.Sum(t => t.NetTotal);
                            var owner = ViewBag.Owner as AppUser;
                        }
                        <tr>
                            <td colspan="2">Tổng cộng</td>
                            <td class="text-end">@grp.Sum(t => t.AmountPay).ToString("N0") đ</td>
                            <td class="text-end">@grp.Sum(t => t.AmountReceive).ToString("N0") đ</td>
                            <td class="text-end @(totalNet >= 0 ? "text-success" : "text-danger")">
                                @(totalNet >= 0 ? "+" : "")@totalNet.ToString("N0") đ
                            </td>
                        </tr>
                    </tfoot>
                </table>

                @if (totalNet < 0 && owner != null && !string.IsNullOrEmpty(owner.BankAccountNumber))
                {
                    <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                        <div class="small">
                            <div class="fw-bold text-uppercase mb-1">Thanh toán qua Ngân hàng:</div>
                            <div>Ngân hàng: <strong>@owner.BankName</strong></div>
                            <div>STK: <strong>@owner.BankAccountNumber</strong></div>
                            <div>Chủ TK: <strong>@owner.BankAccountName</strong></div>
                        </div>
                        <div class="text-center">
                            <img src="https://img.vietqr.io/image/@(owner.BankName)-@(owner.BankAccountNumber)-compact2.png?amount=@(Math.Abs(totalNet))&addInfo=@(Uri.EscapeDataString("Dong hui ngay " + date.ToString("dd/MM") + " " + grp.Key))&accountName=@(Uri.EscapeDataString(owner.BankAccountName ?? ""))" 
                                 style="width: 120px; height: 120px;" class="border shadow-sm bg-white" alt="QR Thanh toán" />
                            <div class="small mt-1 text-muted">Quét mã trả hụi</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<div class="no-print mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← Sổ hụi</a>
</div>
