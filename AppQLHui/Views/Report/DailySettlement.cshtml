@model AppQLHui.DTOs.DailySettlementDto
@{
    ViewData["Title"] = "Báo Cáo Thu Hụi Ngày";
}

<div class="animate-fade-in no-print">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-800 mb-0">📅 Báo Cáo Gom Hụi</h2>
            <p class="text-secondary small mb-0">Ngày: @Model.Date.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            <form method="get" class="d-flex gap-2">
                <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control rounded-pill border-0 shadow-sm" style="width: 180px;" onchange="this.form.submit()" />
            </form>
            <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-printer me-1"></i> In Toàn Bộ
            </button>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="card stat-card-premium h-100">
                <div class="stat-label uppercase opacity-75">TỔNG THU (GOM VÀO)</div>
                <div class="stat-value text-success">@Model.GrandTotalCollect.ToString("N0") <small>đ</small></div>
                <div class="mt-2 text-muted fw-bold">@Model.PlayerTotals.Count(p => p.TotalToPay > 0) người nộp</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card stat-card-premium danger h-100">
                <div class="stat-label uppercase opacity-75">TỔNG CHI (GIAO ĐI)</div>
                <div class="stat-value text-danger">@Model.GrandTotalPayout.ToString("N0") <small>đ</small></div>
                <div class="mt-2 text-muted fw-bold">@Model.PlayerTotals.Count(p => p.TotalToReceive > 0) người hốt</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-lg border-0 overflow-hidden" style="border-radius: 20px;">
    <div class="card-header bg-primary text-white py-3">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list-check me-2"></i>Chi tiết thu chi ngày @Model.Date.ToString("dd/MM/yyyy")</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Hụi viên</th>
                        <th class="text-end">Tiền đóng</th>
                        <th class="text-end">Tiền hốt</th>
                        <th class="text-end">Đóng - Hốt</th>
                        <th class="text-end pe-4 no-print">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in Model.PlayerTotals.OrderByDescending(p => Math.Abs(p.NetBalance)))
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@player.PlayerName</div>
                                <div class="small text-muted">@player.Details.Count dây tham gia</div>
                            </td>
                            <td class="text-end fw-bold text-dark">@(player.TotalToPay > 0 ? player.TotalToPay.ToString("N0") : "-")</td>
                            <td class="text-end fw-bold text-success">@(player.TotalToReceive > 0 ? player.TotalToReceive.ToString("N0") : "-")</td>
                            <td class="text-end">
                                <span class="badge @(player.NetBalance >= 0 ? "bg-success" : "bg-danger") rounded-pill px-3 py-2">
                                    @(player.NetBalance >= 0 ? "+" : "")@player.NetBalance.ToString("N0")
                                </span>
                            </td>
                            <td class="text-end pe-4 no-print">
                                <a asp-action="IndividualSummary" asp-route-playerId="@player.PlayerId" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                   class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                   Xuất Bill lẻ <i class="bi bi-receipt ms-1"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.PlayerTotals.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x fs-1 opacity-25"></i>
                <p class="mt-3">Không có giao dịch nào trong ngày này.</p>
            </div>
        }
    </div>
</div>

<style>
    @@media print {
        .no-print { display: none !important; }
        .card { border: none !important; box-shadow: none !important; }
        .table { width: 100% !important; margin: 0 !important; }
        .card-header { background-color: #f8f9fa !important; color: black !important; border-bottom: 2px solid black !important; }
        .badge { color: black !important; background: transparent !important; border: 1px solid black !important; font-weight: bold; }
    }
</style>
