@model List<AppQLHui.Services.UnpaidTontineDto>
@{
    ViewData["Title"] = "Sổ Công Nợ (Chưa Đóng Hụi)";
    decimal grandTotal = Model.Sum(t => t.TotalUnpaidAmount);
    int totalUnpaidPlayers = Model.Sum(t => t.UnpaidPlayers.Count);
}

@Html.AntiForgeryToken()

<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-800 mb-0">📕 Sổ Nợ Chưa Thu</h2>
            <p class="text-secondary">Theo dõi và gạch nợ hụi viên chưa đóng tiền</p>
        </div>
        <div class="text-end">
            <div class="text-muted small fw-bold">Tổng tiền đang ghim</div>
            <div class="fs-3 fw-800 text-danger">@Math.Round(grandTotal).ToString("N0") ₫</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5 text-center text-muted d-flex flex-column align-items-center">
                <i class="bi bi-box2-heart font-primary mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
                <h4 class="fw-bold text-success mb-0">Tuyệt vời!</h4>
                <p>Không có hụi viên nào nợ tiền kỳ khui.</p>
            </div>
        </div>
        return;
    }

    <div class="row g-4">
        @foreach (var tontine in Model)
        {
            <div class="col-12" id="tontine-card-@tontine.TontineId">
                <div class="card shadow-sm border-0" style="border-radius: 16px;">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center" style="border-radius: 16px 16px 0 0;">
                        <h5 class="mb-0 fw-bold text-primary">
                            <i class="bi bi-bookmark-fill me-2"></i>@tontine.TontineName
                        </h5>
                        <div class="d-flex align-items-center gap-3">
                            <button id="btn-bulk-@tontine.TontineId" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm fw-bold d-none" onclick="processBulk(@tontine.TontineId)">
                                <i class="bi bi-check2-all me-1"></i> Thu tiền đã chọn
                            </button>
                            <div class="badge bg-danger rounded-pill px-3 py-2 shadow-sm">
                                Thuộc @tontine.UnpaidPlayers.Count người • Tổng: <span id="tontine-total-@tontine.TontineId">@Math.Round(tontine.TotalUnpaidAmount).ToString("N0")</span> đ
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary small text-uppercase">
                                    <tr>
                                        <th class="ps-4 py-3" style="width: 45px;">
                                            <input type="checkbox" class="form-check-input border-secondary shadow-none" onchange="toggleTontineGroup(@tontine.TontineId, this)" title="Chọn tất cả">
                                        </th>
                                        <th>Hụi viên</th>
                                        <th>Kỳ trống</th>
                                        <th class="text-end text-muted">Tổng nợ</th>
                                        <th class="text-end">Cần đóng</th>
                                        <th class="text-end pe-4" style="width: 15%;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="tontine-group-@tontine.TontineId">
                                    @foreach (var player in tontine.UnpaidPlayers)
                                    {
                                        var allTxIds = string.Join(",", player.Transactions.Select(t => t.TransactionId));
                                        var totalDebt = player.Transactions.Sum(t => t.TotalDebtAmount);
                                        var totalPaid = player.Transactions.Sum(t => t.PaidAmount);
                                        var totalRemain = player.Transactions.Sum(t => t.RemainingAmount);
                                        var cyclesText = string.Join(", ", player.Transactions.OrderBy(t => t.SequenceNumber).Select(t => "Kỳ " + t.SequenceNumber));

                                        <tr class="align-middle">
                                            <td class="ps-4">
                                                <input type="checkbox" class="form-check-input border-secondary shadow-none tx-item-cb" value="@allTxIds" onchange="updateGroupUI(@tontine.TontineId)">
                                            </td>
                                            <td class="fw-bold text-dark">
                                                <i class="bi bi-person-circle text-muted me-2"></i>@player.PlayerName
                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var tx in player.Transactions.OrderBy(t => t.SequenceNumber))
                                                    {
                                                        <span class="badge bg-light text-primary border border-primary-subtle px-3 py-2 shadow-sm" style="font-size: 0.85rem;" title="@tx.DrawDate.ToString("dd/MM/yyyy")">
                                                            Kỳ @tx.SequenceNumber <span class="fw-normal opacity-75 ms-1">(@tx.DrawDate.ToString("dd/MM"))</span>
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-end text-muted fw-bold">
                                                @if (totalPaid > 0)
                                                {
                                                    <span class="small d-block text-decoration-line-through">@Math.Round(totalDebt).ToString("N0")đ</span>
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-1 mt-1">Đã góp @Math.Round(totalPaid).ToString("N0")đ</span>
                                                }
                                                else
                                                {
                                                    <span>@Math.Round(totalDebt).ToString("N0") đ</span>
                                                }
                                            </td>
                                            <td class="text-end fw-900 text-danger" style="font-size: 1.1rem;">
                                                @Math.Round(totalRemain).ToString("N0") đ
                                            </td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-sm btn-outline-success fw-bold rounded-pill shadow-sm px-3" onclick="promptSettleGroup('@allTxIds', @totalRemain, '@player.PlayerName.Replace("'", "\\'")', '@cyclesText')">
                                                    <i class="bi bi-cash-coin me-1"></i> Thu
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .fw-900 { font-weight: 900; }
    .tx-item-cb { width: 20px; height: 20px; cursor: pointer; }
    .form-check-input:checked { background-color: #10b981; border-color: #10b981; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function toggleTontineGroup(tontineId, headerCb) {
            const group = document.getElementById('tontine-group-' + tontineId);
            const checkboxes = group.querySelectorAll('.tx-item-cb');
            checkboxes.forEach(cb => {
                cb.checked = headerCb.checked;
            });
            updateGroupUI(tontineId);
        }

        function updateGroupUI(tontineId) {
            const group = document.getElementById('tontine-group-' + tontineId);
            const checkedCount = group.querySelectorAll('.tx-item-cb:checked').length;
            const btn = document.getElementById('btn-bulk-' + tontineId);
            
            if (checkedCount > 0) {
                btn.classList.remove('d-none');
                btn.innerText = `Thu tiền đã chọn (${checkedCount} người)`;
            } else {
                btn.classList.add('d-none');
            }
        }

        function processBulk(tontineId) {
            const group = document.getElementById('tontine-group-' + tontineId);
            // Collect all transaction IDs from selected grouped checkboxes (some values might be "1,2,3")
            const selectedIds = Array.from(group.querySelectorAll('.tx-item-cb:checked'))
                                    .flatMap(cb => cb.value.split(','));
            
            Swal.fire({
                title: 'Xác nhận thu hàng loạt?',
                text: `Bạn đang thực hiện thu tiền nợ. Tất cả các kỳ hụi của những người đã chọn sẽ được ghi nhận là ĐÃ THU ĐỦ.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: '✅ Đúng, đã thu đủ',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const params = new URLSearchParams();
                    selectedIds.forEach(id => params.append('transactionIds', id));

                    fetch('/Report/BulkSettle', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: params.toString()
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success', 
                                title: 'Thành công',
                                text: res.message,
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => window.location.reload());
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            });
        }

        function promptSettleGroup(txIds, remainAmount, playerName, cyclesText) {
            Swal.fire({
                title: `Thu tiền: ${playerName}`,
                html: `<div class="mb-3">Khoản nợ: <strong>${cyclesText}</strong></div>
                       <div class="h4 fw-bold text-danger mb-3">Tổng cộng: ${fmtNum(remainAmount)} đ</div>
                       <p class="text-secondary small">Xác nhận đã thu đủ số tiền này cho tất cả các kỳ nêu trên?</p>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: '✅ Xác nhận thu đủ',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const params = new URLSearchParams();
                    txIds.split(',').forEach(id => params.append('transactionIds', id));

                    fetch('/Report/BulkSettle', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: params.toString()
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success', 
                                title: 'Thành công',
                                text: res.message,
                                timer: 2000,
                                showConfirmButton: false
                            }).then(() => window.location.reload());
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            });
        }

        function fmtNum(n) {
            return Math.round(n).toLocaleString('vi-VN');
        }

        function processSettlement(txId, amount) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('/Report/ToggleSettlement', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token
                },
                body: `transactionId=${txId}&amount=${amount}`
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    Swal.fire({
                        icon: 'success', 
                        title: 'Đã thu tiền',
                        text: res.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            })
            .catch(err => {
                Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
            });
        }
    </script>
}
