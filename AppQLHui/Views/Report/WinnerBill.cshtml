@model AppQLHui.Models.Draw
@{
    ViewData["Title"] = "Giấy giao hụi";
    var winner = Model.WinningShare?.Player;
    var tontine = Model.Tontine;
    
    // Calculate counts for formula display
    var transactions = Model.Transactions.ToList();
    var livingCount = transactions.Sum(t => t.AmountReceive == 0 && t.AmountPay < tontine.BaseAmount ? 1 : 0);
    var deadCount = transactions.Sum(t => t.AmountReceive == 0 && t.AmountPay == tontine.BaseAmount ? 1 : 0);
    var livingAmount = tontine.BaseAmount - Model.BidAmount;
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h4 class="fw-800 mb-0">📄 Giấy Giao Hụi</h4>
        <p class="text-secondary small mb-0">Hợp đồng bàn giao tiền hụi kỳ #@Model.SequenceNumber</p>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-printer me-1"></i> In Hợp Đồng
        </button>
        <a asp-controller="Tontine" asp-action="Details" asp-route-id="@tontine.Id" class="btn btn-light rounded-pill px-3">Quay lại</a>
    </div>
</div>

<div class="bill-container mx-auto bg-white p-5 shadow-sm border" style="max-width: 800px; font-family: 'Times New Roman', serif;">
    <!-- HEADER -->
    <div class="text-center mb-5 border-bottom pb-4">
        <h2 class="fw-bold mb-1">GIẤY GIAO HỤI</h2>
        <div class="text-uppercase tracking-widest text-secondary small">Hệ Thống Quản Lý Hụi Chuyên Nghiệp</div>
        <div class="mt-3">
            <span class="badge bg-dark rounded-pill px-3 py-2">Kỳ #@Model.SequenceNumber</span>
            <span class="ms-2 text-muted">Ngày khui: @Model.DrawDate.ToString("dd/MM/yyyy")</span>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-6">
            <h6 class="text-uppercase fw-bold text-primary small border-bottom pb-2 mb-3">1. THÔNG TIN DÂY HỤI</h6>
            <div class="d-flex justify-content-between mb-1"><span>Tên dây:</span> <strong>@tontine.Name</strong></div>
            <div class="d-flex justify-content-between mb-1"><span>Mệnh giá:</span> <strong>@tontine.BaseAmount.ToString("N0") đ</strong></div>
            <div class="d-flex justify-content-between mb-1"><span>Tiền thảo:</span> <strong>@tontine.CommissionFee.ToString("N0") đ</strong></div>
        </div>
        <div class="col-6">
            <h6 class="text-uppercase fw-bold text-success small border-bottom pb-2 mb-3">2. NGƯỜI HỐT HỤI</h6>
            <div class="d-flex justify-content-between mb-1"><span>Hụi viên:</span> <strong class="fs-5">@winner?.Name</strong></div>
            <div class="d-flex justify-content-between mb-1"><span>Số điện thoại:</span> <strong>@winner?.Phone</strong></div>
            <div class="d-flex justify-content-between mb-1"><span>Tiền thăm (Bid):</span> <strong class="text-warning">@Model.BidAmount.ToString("N0") đ</strong></div>
        </div>
    </div>

    <!-- FORMULA BOX (Ref: Image 2) -->
    <div class="bg-light p-4 rounded-3 mb-5 border">
        <h6 class="fw-bold mb-3 text-center border-bottom pb-2">CHI TIẾT TÍNH TOÁN (CÔNG THỨC)</h6>
        
        <div class="row text-center align-items-center">
            <div class="col-5">
                <div class="small text-muted mb-1">HỤI SỐNG</div>
                <div class="fs-5 fw-bold text-primary">@livingCount <span class="small opacity-50">phần</span> × @livingAmount.ToString("N0") đ</div>
            </div>
            <div class="col-2 fs-4 text-muted">+</div>
            <div class="col-5">
                <div class="small text-muted mb-1">HỤI CHẾT</div>
                <div class="fs-5 fw-bold text-danger">@deadCount <span class="small opacity-50">phần</span> × @tontine.BaseAmount.ToString("N0") đ</div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
            <div>
                <div class="text-secondary small">TỔNG GOM (SỐNG + CHẾT)</div>
                <div class="fs-4 fw-bold text-dark">@((livingCount * livingAmount + deadCount * tontine.BaseAmount).ToString("N0")) đ</div>
            </div>
            <div class="text-center px-4 fs-3 text-muted">-</div>
            <div class="text-end">
                <div class="text-secondary small">THẢO + NỢ CŨ</div>
                <div class="fs-4 fw-bold text-danger">@((Model.CollectedFee + Model.OldDebtDeduction).ToString("N0")) đ</div>
            </div>
        </div>

        @if (Model.OldDebtDeduction > 0)
        {
            <div class="mt-2 text-end text-danger small">
                (Tiền thảo: @Model.CollectedFee.ToString("N0") đ | Trừ nợ cũ: @Model.OldDebtDeduction.ToString("N0") đ)
            </div>
        }

        <div class="mt-4 p-3 bg-primary text-white rounded-3 shadow-sm text-center">
            <div class="small opacity-75">SỐ TIỀN THỰC NHẬN (THỰC GIAO)</div>
            <div class="fs-3 fw-800">@Model.ActualReceived.ToString("N0") đ</div>
        </div>
    </div>

    <!-- SIGNATURES -->
    <div class="row mt-5 pt-4 text-center">
        <div class="col-6">
            <p class="mb-5"><strong>Bên Nhận</strong></p>
            <div class="text-muted mt-5">(Ký và ghi rõ họ tên)</div>
            <div class="mt-4 fs-5 fw-bold">@winner?.Name</div>
        </div>
        <div class="col-6">
            <p class="mb-5"><strong>Chủ Hụi</strong></p>
            <div class="text-muted mt-5">(Ký và ghi rõ họ tên)</div>
        </div>
    </div>

    <!-- DISCLAIMER -->
    <div class="mt-5 pt-5 pb-2 text-center text-secondary small border-top" style="font-style: italic;">
        Tôi đã đọc, kiểm đếm và nhận đủ số tiền giao hụi trên trong tình trạng hoàn toàn tỉnh táo, 
        không bị ép buộc, phải đóng lại hoàn thành dây hụi cho đến mãn dây. 
        Mọi phát sinh về sau tôi sẽ chịu trách nhiệm trước Pháp Luật!
    </div>
</div>

<style>
    @@media print {
        body { background: white !important; }
        .sidebar, .navbar, .no-print { display: none !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .bill-container { border: none !important; box-shadow: none !important; margin: 0 !important; width: 100% !important; max-width: none !important; }
    }
    .bill-container { min-height: 297mm; }
    .fw-800 { font-weight: 800; }
    .tracking-widest { letter-spacing: 0.1em; }
</style>
