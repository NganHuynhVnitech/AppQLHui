@model AppQLHui.Models.Draw
@{
    ViewData["Title"] = "Giấy giao hụi";
    // Using CDN version of html2canvas for image export
    var html2canvasCdn = "https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js";
    var winner = Model.WinningShare?.Player;
    var tontine = Model.Tontine;
    
    // Calculate counts for formula display
    // Priority: Use stored values in Draw record. Fallback: derive from sequence number.
    var livingCount = Model.CountLivingShares;
    var deadCount = Model.CountDeadShares;
    
    // If fields are 0 (old records), fallback to sequence logic
    // Strict formula: Total = DeadCount + LivingCount + 1 (the winner)
    if (livingCount == 0 && deadCount == 0 && Model.SequenceNumber > 0)
    {
        deadCount = Model.SequenceNumber - 1;
        livingCount = tontine.TotalShares - Model.SequenceNumber;
    }

    var livingAmount = tontine.BaseAmount - Model.BidAmount;
    var tontineTotalValue = (livingCount * livingAmount) + (deadCount * tontine.BaseAmount);
    var remainingShares = tontine.TotalShares - Model.SequenceNumber;

    // Owner info from database (the user who owns this tontine)
    var owner = tontine.Owner;
    var houseOwner = owner?.FullName ?? "Chưa rõ";
    var housePhone = owner?.Phone ?? "Chưa cập nhật";
    
    var houseBankText = "Chưa cập nhật tài khoản";
    if (owner != null && !string.IsNullOrEmpty(owner.BankAccountNumber))
    {
        houseBankText = $"{(string.IsNullOrEmpty(owner.BankName) ? "Ngân hàng" : owner.BankName)}: <span class='text-danger fw-bold'>{owner.BankAccountNumber}</span>{(string.IsNullOrEmpty(owner.BankAccountName) ? "" : " - " + owner.BankAccountName)}";
    }
}

<div class="animate-fade-in">
    <!-- Desktop Actions Bar -->
    <div class="d-none d-md-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h2 class="fw-800 mb-0">📄 Giấy Giao Hụi</h2>
            <p class="text-secondary small mb-0">Mẫu hợp đồng chuyên nghiệp & thẩm mỹ</p>
        </div>
        <div class="d-flex gap-2">
            <div class="form-check form-switch bg-white px-3 py-2 rounded-pill shadow-sm border border-primary border-opacity-25 d-flex align-items-center gap-2">
                <input class="form-check-input ms-0" type="checkbox" id="toggleOtherDeduction" checked onchange="syncToggles(this)">
                <label class="form-check-label fw-bold small text-primary mb-0 pe-2" for="toggleOtherDeduction">Tính Trừ Khác</label>
            </div>
            <button onclick="exportBillToImage('download')" class="btn btn-warning rounded-pill px-3 shadow-sm">
                <i class="bi bi-image me-1"></i> Xuất hình
            </button>
            <button onclick="window.print()" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-printer me-1"></i> In Bill
            </button>
            <a asp-controller="Draw" asp-action="Index" asp-route-tontineId="@tontine.Id" class="btn btn-success rounded-pill px-3 shadow-sm">
                <i class="bi bi-arrow-right-circle me-1"></i> Khui tiếp
            </a>
            <a asp-controller="Tontine" asp-action="Details" asp-route-id="@tontine.Id" class="btn btn-light rounded-pill px-3">Đóng</a>
        </div>
    </div>

    <!-- Mobile Floating Action Bar (Fixed Bottom) -->
    <div class="d-md-none fixed-bottom bg-white border-top p-2 shadow-lg no-print z-index-top" style="z-index: 1050;" id="mobileActionBar">
        <div class="d-flex justify-content-between align-items-center gap-2">
            <div class="form-check form-switch bg-light px-2 py-1 rounded-pill border d-flex align-items-center gap-1 mb-0">
                <input class="form-check-input ms-0" type="checkbox" id="toggleOtherDeductionMobile" checked onchange="syncToggles(this)">
                <label class="form-check-label fw-bold small text-primary mb-0 pe-1" for="toggleOtherDeductionMobile" style="font-size: 10px;">Trừ khác</label>
            </div>
            <div class="d-flex gap-1 flex-grow-1 justify-content-end">
                <button onclick="exportBillToImage('share')" class="btn btn-warning btn-sm rounded-pill px-2">
                    <i class="bi bi-camera"></i>
                </button>
                <button onclick="window.print()" class="btn btn-primary btn-sm rounded-pill px-2">
                    <i class="bi bi-printer"></i>
                </button>
                <a asp-controller="Draw" asp-action="Index" asp-route-tontineId="@tontine.Id" class="btn btn-success btn-sm rounded-pill px-3 fw-bold">
                    Khui tiếp
                </a>
            </div>
        </div>
    </div>

    <!-- CONTRACT CONTENT -->
    <div class="card shadow-lg border-0 mb-5 p-3 p-md-5 bg-white receipt-compact" id="receipt-print">
        <!-- Header -->
        <div class="text-center mb-2 pb-1 border-bottom header-section">
            <h5 class="fw-800 text-primary mb-0">@houseOwner.ToUpper()</h5>
            <div class="text-secondary fw-bold fs-xs">SĐT: @housePhone</div>
            <div class="smallest-info mb-1">@Html.Raw(houseBankText)</div>
            
            <h2 class="fw-800 text-uppercase mb-0 main-title" style="letter-spacing: 3px;">GIẤY GIAO HỤI</h2>
            <p class="text-secondary text-uppercase tracking-widest smallest mb-2 d-none d-md-block">HỆ THỐNG QUẢN LÝ HỤI CHUYÊN NGHIỆP</p>
            
            <div class="d-flex justify-content-center gap-1 mb-1">
                <span class="badge bg-primary px-2 py-0 fs-xs">Kỳ #@Model.SequenceNumber</span>
                <span class="badge bg-light text-dark border px-2 py-0 fs-xs">Ngày: @Model.DrawDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        <!-- Section 1 & 2 Info Cards -->
        <div class="row g-2 mb-3">
            <div class="col-6">
                <div class="p-2 bg-light rounded-3 h-100 border border-opacity-10 border-primary info-box">
                    <h6 class="text-primary fw-800 text-uppercase fs-xs mb-2 border-bottom pb-1">1. Dây hụi</h6>
                    <div class="d-flex justify-content-between mb-1 smallest"><span>Ngày mở:</span> <span class="fw-bold">@tontine.CreatedAt.ToString("dd/MM/yyyy")</span></div>
                    <div class="d-flex justify-content-between mb-1 smallest"><span>Dây hụi:</span> <span class="fw-bold text-primary">@tontine.BaseAmount.ToString("N0")</span></div>
                    <div class="d-flex justify-content-between mb-1 smallest"><span>Số phần:</span> <span class="fw-bold">@tontine.TotalShares</span></div>
                    <div class="d-flex justify-content-between mb-0 smallest"><span>Tên:</span> <span class="fw-bold text-truncate ms-1">@tontine.Name</span></div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-2 bg-primary text-white rounded-3 h-100 shadow-sm info-box">
                    <h6 class="opacity-75 fw-bold text-uppercase fs-xs mb-2 border-bottom border-white border-opacity-25 pb-1">2. Thanh toán</h6>
                    <div class="winner-name fw-800 mb-1">@winner?.Name?.ToUpper()</div>
                    <div class="d-flex justify-content-between smallest opacity-75"><span>Thăm:</span> <span class="fw-bold text-warning">@Model.BidAmount.ToString("N0")</span></div>
                    <div class="d-flex justify-content-between smallest opacity-75 mt-1"><span>Số kỳ:</span> <span class="fw-800">@Model.SequenceNumber</span></div>
                </div>
            </div>
        </div>

        <!-- Formula Cards -->
        <div class="row g-1 mb-2">
            <div class="col-6">
                <div class="p-1 px-2 bg-success bg-opacity-10 text-success rounded-3 border border-success border-opacity-25 text-center h-100">
                    <div class="smallest fw-bold text-uppercase opacity-75">Hụi Sống</div>
                    <div class="fw-800 fs-xs">@livingCount <small class="smallest">phần</small> × @((livingAmount / 1000).ToString("N0"))k</div>
                    <div class="border-top border-success border-opacity-10 mt-1">TC <span class="fw-800">@((livingCount * livingAmount).ToString("N0"))</span></div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-1 px-2 bg-danger bg-opacity-10 text-danger rounded-3 border border-danger border-opacity-25 text-center h-100">
                    <div class="smallest fw-bold text-uppercase opacity-75">Hụi Chết</div>
                    <div class="fw-800 fs-xs">@deadCount <small class="smallest">phần</small> × @((tontine.BaseAmount / 1000).ToString("N0"))k</div>
                    <div class="border-top border-danger border-opacity-10 mt-1">TC <span class="fw-800">@((deadCount * tontine.BaseAmount).ToString("N0"))</span></div>
                </div>
            </div>
        </div>

        <!-- Financial Summary Card -->
        <div class="card border-0 bg-light rounded-3 p-2 mb-2 shadow-sm border border-black border-opacity-5">
            <div class="d-flex justify-content-between fw-bold smallest mb-0">
                <span>Tiền thu:</span>
                <span>@tontineTotalValue.ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between text-secondary smallest mb-0">
                <span>- Thảo/Nợ:</span>
                <span>@((Model.CollectedFee + Model.OldDebtDeduction).ToString("N0"))</span>
            </div>
            
            <div class="d-flex justify-content-between text-secondary smallest mb-0" id="other-deduction-row" style="@(Model.OtherDeduction == 0 ? "display:none" : "")">
                <span>- Trừ khác:</span>
                <span id="other-deduction-value">@Model.OtherDeduction.ToString("N0")</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mt-1 border-top pt-1">
                <span class="fw-800 text-dark smallest">THỰC GIAO:</span>
                <span class="fs-4 fw-800 text-danger"><span id="final-total">@Model.ActualReceived.ToString("N0")</span> <small class="smallest">đ</small></span>
            </div>
        </div>

        <!-- Footer Note -->
        <div class="text-center mb-2">
            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill fw-bold fs-xs">Còn @remainingShares phần mãn dây</span>
        </div>

        <!-- Disclaimer -->
        <p class="text-center text-danger fw-bold smallest mb-2" style="line-height: 1.2;">
            Tôi đã đọc, kiểm đếm và nhận đủ tiền, cam kết đóng hụi đủ đến mãn dây.
        </p>

        <!-- Signatures -->
        <div class="row text-center g-0">
            <div class="col-6 border-end">
                <div class="fw-800 smallest text-secondary">BÊN NHẬN</div>
                <div class="fw-800 smallest text-dark py-1">@winner?.Name</div>
            </div>
            <div class="col-6 ps-2">
                <div class="fw-800 smallest text-secondary">BÊN GIAO</div>
                <div class="fw-800 smallest text-primary py-1">@houseOwner</div>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-800 { font-weight: 800; }
    .tracking-widest { letter-spacing: 0.2em; }
    .italic { font-style: italic; }
    .animate-fade-in { animation: fadeIn 0.5s ease-out; }
    .smallest { font-size: 0.75rem; }
    .smallest-info { font-size: 0.7rem; }
    .fs-xs { font-size: 0.7rem !important; }
    .fs-6 { font-size: 0.85rem !important; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    #receipt-print { max-width: 850px; margin: 0 auto; min-height: 297mm; }

    @@media (max-width: 576px) {
        body { padding-bottom: 70px !important; } /* Space for fixed bottom bar */
        #receipt-print {
            min-height: auto !important;
            padding: 15px !important;
            border-radius: 12px !important;
            margin-top: 10px !important;
        }
        .main-title { font-size: 1.3rem !important; letter-spacing: 2px !important; }
        .header-section { margin-bottom: 0.75rem !important; padding-bottom: 0.5rem !important; }
        .header-section h5 { margin-bottom: 4px !important; font-size: 1.1rem !important; }
        .info-box { padding: 8px !important; }
        .winner-name { font-size: 1rem !important; }
        .fs-4 { font-size: 1.5rem !important; }
        .receipt-compact { margin-bottom: 1rem !important; }
    }

    @@media print {
        header, .no-print, .btn, .navbar, .sidebar { display: none !important; }
        body { background-color: white !important; margin: 0; padding: 0; }
        .card { box-shadow: none !important; border: none !important; padding: 0 !important; margin: 0 !important; }
        #receipt-print { max-width: 100% !important; width: 100% !important; border: none !important; margin: 0 !important; min-height: 297mm !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .bg-light { background-color: #f8f9fa !important; -webkit-print-color-adjust: exact; }
        .bg-primary { background-color: #0d6efd !important; -webkit-print-color-adjust: exact; color: white !important; }
        .bg-success { background-color: #198754 !important; -webkit-print-color-adjust: exact; }
        .bg-danger { background-color: #dc3545 !important; -webkit-print-color-adjust: exact; }
        .text-primary { color: #0d6efd !important; -webkit-print-color-adjust: exact; }
        .text-danger { color: #dc3545 !important; -webkit-print-color-adjust: exact; }
        .text-success { color: #198754 !important; -webkit-print-color-adjust: exact; }
    }
</style>

<script>
    function syncToggles(el) {
        const desktopToggle = document.getElementById('toggleOtherDeduction');
        const mobileToggle = document.getElementById('toggleOtherDeductionMobile');
        const isChecked = el.checked;
        
        if (desktopToggle) desktopToggle.checked = isChecked;
        if (mobileToggle) mobileToggle.checked = isChecked;
        
        const row = document.getElementById('other-deduction-row');
        const totalEl = document.getElementById('final-total');
        if (!row || !totalEl) return;

        let otherDeduction = parseInt("@Model.OtherDeduction".replace(/[^0-9]/g, "")) || 0;
        let baseTotal = parseInt("@Model.ActualReceived".replace(/[^0-9]/g, "")) || 0;
        
        const totalWithoutDeduction = baseTotal + otherDeduction; 
        const totalWithDeduction = baseTotal;

        if (isChecked) {
            if (otherDeduction > 0) row.style.display = 'flex';
            totalEl.innerText = totalWithDeduction.toLocaleString("vi-VN");
        } else {
            row.style.display = 'none';
            totalEl.innerText = totalWithoutDeduction.toLocaleString("vi-VN");
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        // Initial setup based on current toggle state
        const toggle = document.getElementById('toggleOtherDeduction');
        if (toggle) syncToggles(toggle);

        // Load html2canvas
        const script = document.createElement('script');
        script.src = "@html2canvasCdn";
        document.head.appendChild(script);
    });

    async function exportBillToImage(mode) {
        const target = document.getElementById('receipt-print');
        if (!target || typeof html2canvas === 'undefined') {
            alert("Đang tải thư viện xử lý ảnh, vui lòng thử lại sau 2 giây.");
            return;
        }

        const btn = event.currentTarget;
        const originalContent = btn.innerHTML;
        btn.innerHTML = mode === 'share' ? '<i class="bi bi-hourglass-split"></i>' : '<i class="bi bi-hourglass-split me-1"></i> Đang xử lý...';
        btn.disabled = true;

        try {
            // High resolution scale
            const canvas = await html2canvas(target, {
                scale: 2, 
                backgroundColor: "#ffffff",
                useCORS: true,
                logging: false
            });

            if (mode === 'download') {
                const link = document.createElement('a');
                link.download = `Giay_Giao_Hui_Ky_${"@Model.SequenceNumber"}.png`;
                link.href = canvas.toDataURL("image/png");
                link.click();
            } else if (mode === Modes.COPY) {
                // Copy to clipboard (might not work on all mobiles)
                canvas.toBlob(blob => {
                    const item = new ClipboardItem({ "image/png": blob });
                    navigator.clipboard.write([item]).then(() => {
                        alert("Đã sao chép hình ảnh vào khay nhớ tạm! Hãy mở Zalo và dán (Paste) để gửi.");
                    }).catch(err => {
                        // Fallback to download if copy fails
                        const link = document.createElement('a');
                        link.download = `Giay_Giao_Hui.png`;
                        link.href = canvas.toDataURL("image/png");
                        link.click();
                    });
                });
            } else if (mode === 'share') {
                // Use Web Share API for mobile if supported
                canvas.toBlob(async (blob) => {
                    const file = new File([blob], "GiayGiaoHui.png", { type: "image/png" });
                    if (navigator.share && navigator.canShare({ files: [file] })) {
                        try {
                            await navigator.share({
                                files: [file],
                                title: 'Giấy giao hụi',
                                text: 'Gửi từ App Quản Lý Hụi'
                            });
                        } catch (err) {
                            // If share is cancelled or fails, show the image to long-press save
                            showImageModal(canvas.toDataURL());
                        }
                    } else {
                        showImageModal(canvas.toDataURL());
                    }
                });
            }
        } catch (e) {
            console.error(e);
            alert("Lỗi khi tạo ảnh: " + e.message);
        } finally {
            btn.innerHTML = originalContent;
            btn.disabled = false;
        }
    }

    function showImageModal(dataUrl) {
        // Fallback for mobile devices that don't support share/download well
        const img = new Image();
        img.src = dataUrl;
        img.style.maxWidth = "100%";
        
        const win = window.open("");
        win.document.write("<html><body style='margin:0; text-align:center;'>");
        win.document.write("<p style='padding:10px; font-family:sans-serif; background:#f8f9fa;'>Hãy nhấn giữ vào ảnh bên dưới rồi chọn <b>Lưu ảnh</b> hoặc <b>Chia sẻ</b> lên Zalo.</p>");
        win.document.write(img.outerHTML);
        win.document.write("</body></html>");
    }

    const Modes = { DOWNLOAD: 'download', COPY: 'copy', SHARE: 'share' };
</script>
