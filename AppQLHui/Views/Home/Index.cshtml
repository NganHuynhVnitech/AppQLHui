@model AppQLHui.Services.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
}

<h4 class="mb-4">📊 Dashboard - Tổng quan</h4>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card green p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Dây hụi đang chạy</div>
                    <div class="fs-2 fw-bold text-success">@Model.RunningTontineCount</div>
                </div>
                <span class="fs-1 text-success opacity-50">📋</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card blue p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Tiền thảo thu tháng này</div>
                    <div class="fs-2 fw-bold text-primary">@Model.MonthlyFeesCollected.ToString("N0") đ</div>
                </div>
                <span class="fs-1 text-primary opacity-50">💰</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card orange p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Kỳ khui hôm nay</div>
                    <div class="fs-2 fw-bold text-warning">@Model.TodayDraws.Count</div>
                </div>
                <span class="fs-1 text-warning opacity-50">🎯</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning text-dark fw-bold">
                ⚠️ Dây hụi đến hạn cần khui
            </div>
            <div class="card-body p-0">
                @if (!Model.DueTodayTontines.Any())
                {
                    <p class="text-muted p-3 mb-0">Không có dây hụi nào cần khui hôm nay.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var t in Model.DueTodayTontines)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@t.Name</strong>
                                    <span class="badge bg-secondary ms-2">@t.Type</span>
                                </div>
                                <a asp-controller="Draw" asp-action="Index" asp-route-tontineId="@t.Id"
                                   class="btn btn-sm btn-success">Khui ngay</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white fw-bold">
                🎯 Kỳ khui hôm nay
            </div>
            <div class="card-body p-0">
                @if (!Model.TodayDraws.Any())
                {
                    <p class="text-muted p-3 mb-0">Chưa có kỳ khui nào hôm nay.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var d in Model.TodayDraws)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@d.Tontine.Name</strong> - Kỳ #@d.SequenceNumber
                                </div>
                                <a asp-controller="Draw" asp-action="Bill" asp-route-drawId="@d.Id"
                                   class="btn btn-sm btn-outline-primary">Xem bill</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-bold">🚀 Thao tác nhanh</div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Draw" asp-action="Index" class="btn btn-success">🎯 Khui hụi</a>
                    <a asp-controller="Player" asp-action="Create" class="btn btn-primary">➕ Thêm hụi viên</a>
                    <a asp-controller="Tontine" asp-action="Create" class="btn btn-info text-white">📋 Tạo dây hụi</a>
                    <a asp-controller="Report" asp-action="Index" class="btn btn-warning">📈 Xem báo cáo</a>
                    <a asp-controller="Report" asp-action="DailyBill" class="btn btn-outline-secondary">🖨️ Bill hôm nay</a>
                </div>
            </div>
        </div>
    </div>
</div>
