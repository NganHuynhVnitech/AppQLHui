@using AppQLHui.Services
@inject ReportService ReportService
@{
    ViewData["Title"] = "Dashboard - QL Hụi Pro";
    var stats = await ReportService.GetDashboardStatsAsync();
}

<div class="animate-fade-in">
    <!-- HERO SECTION -->
    <div class="hero-section bg-gradient-primary text-white p-5 rounded-5 mb-5 shadow-lg position-relative overflow-hidden">
        <div class="position-relative z-1">
            <h1 class="display-4 fw-800 mb-2">Xin chào, Quản trị viên! 👋</h1>
            <p class="lead opacity-75 mb-4">Chào mừng bạn quay lại hệ thống. Hôm nay có <strong>@stats.DueTodayTontines.Count</strong> dây hụi đến hạn khui.</p>
            <div class="d-flex gap-3 mt-4">
                <a asp-controller="Draw" asp-action="Index" class="btn btn-white rounded-pill px-4 py-3 shadow fw-bold">
                    <i class="bi bi-play-circle-fill text-primary me-2"></i> Bắt đầu làm việc (Khui hụi)
                </a>
                <a asp-controller="Report" asp-action="DailySettlement" class="btn btn-primary bg-primary-dark rounded-pill px-4 py-3 shadow-sm border-0 fw-bold">
                    <i class="bi bi-calendar-check me-2"></i> Gom hụi hôm nay
                </a>
            </div>
        </div>
        <i class="bi bi-graph-up-arrow position-absolute top-50 end-0 translate-middle-y opacity-10 pe-5 display-1"></i>
    </div>

    <!-- QUICK STATS -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card-premium h-100">
                <div class="stat-label">DÂY HỤI ĐANG CHẠY</div>
                <div class="stat-value text-primary">@stats.RunningTontineCount</div>
                <div class="progress mt-3 bg-light" style="height: 6px;">
                    <div class="progress-bar" style="width: 75%"></div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card-premium success h-100">
                <div class="stat-label">THU THẢO TRONG THÁNG</div>
                <div class="stat-value text-success">@stats.MonthlyFeesCollected.ToString("N0") <small>đ</small></div>
                <div class="mt-2 text-muted small"><i class="bi bi-arrow-up-circle-fill me-1"></i> Tăng 12% so với tháng trước</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card-premium warning h-100">
                <div class="stat-label">VỐN HỤI ĐANG QUAY</div>
                <div class="stat-value text-warning">@stats.ActiveTontineCapital.ToString("N0") <small>đ</small></div>
                <div class="mt-2 text-muted small">@stats.TotalPlayers người tham gia</div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card-premium danger h-100">
                <div class="stat-label">CẦN KHUI HÔM NAY</div>
                <div class="stat-value text-danger">@stats.DueTodayTontines.Count</div>
                <div class="mt-2 text-muted small">Cần xử lý ngay!</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- DUE TODAY LIST -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 20px;">
                <div class="card-header bg-white py-4 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-alarm-fill me-2 text-danger"></i>Lịch khui hôm nay</h5>
                    <a asp-controller="Tontine" asp-action="Index" class="btn btn-sm btn-light border rounded-pill px-3">Tất cả dây hụi</a>
                </div>
                <div class="card-body p-0">
                    @if (!stats.DueTodayTontines.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-check fs-1 d-block mb-3 opacity-25"></i>
                            <p>Không có dây hụi nào đến hạn khui hôm nay.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Tên Dây Hụi</th>
                                        <th class="text-end">Mệnh Giá</th>
                                        <th class="text-end pe-4">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in stats.DueTodayTontines)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold">@t.Name</div>
                                                <div class="small text-muted">@t.Type | @t.TotalShares phần</div>
                                            </td>
                                            <td class="text-end fw-bold text-primary">@t.BaseAmount.ToString("N0") <small>đ</small></td>
                                            <td class="text-end pe-4">
                                                <a asp-controller="Draw" asp-action="Index" asp-route-tontineId="@t.Id" 
                                                   class="btn btn-sm btn-gradient-success rounded-pill px-4 shadow-sm border-0">Khui ngay</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS / SIDE REPORTS (Ref: Image 4) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 20px;">
                <div class="card-header bg-white py-4 px-4 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-speedometer2 me-2 text-primary"></i>Phím tắt chức năng</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-6">
                            <a asp-controller="Report" asp-action="DailySettlement" class="quick-action-card bg-soft-primary">
                                <i class="bi bi-file-earmark-spreadsheet text-primary"></i>
                                <span>Gom hụi ngày</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-controller="Report" asp-action="Index" class="quick-action-card bg-soft-success">
                                <i class="bi bi-person-lines-fill text-success"></i>
                                <span>Sổ hụi cá nhân</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-controller="Zalo" asp-action="Index" class="quick-action-card bg-soft-info">
                                <i class="bi bi-robot text-info"></i>
                                <span>Setup Zalo Auto</span>
                            </a>
                        </div>
                        <div class="col-6">
                            <a asp-controller="Tontine" asp-action="Create" class="quick-action-card bg-soft-warning">
                                <i class="bi bi-plus-circle-fill text-warning"></i>
                                <span>Mở dây hụi mới</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-primary-dark { background-color: #1e40af; }
    .hero-section { border: none; }
    .stat-card-premium { border-radius: 20px; transition: transform 0.3s; }
    .stat-card-premium:hover { transform: translateY(-5px); }
    .quick-action-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 24px;
        border-radius: 16px;
        text-decoration: none;
        transition: all 0.2s;
        height: 100%;
        border: 1px solid rgba(0,0,0,0.05);
    }
    .quick-action-card i { font-size: 2rem; margin-bottom: 8px; }
    .quick-action-card span { font-weight: 600; color: #1e293b; font-size: 0.9rem; }
    .quick-action-card:hover { transform: scale(1.05); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
    
    .bg-soft-primary { background-color: #eff6ff; }
    .bg-soft-success { background-color: #f0fdf4; }
    .bg-soft-info { background-color: #f0f9ff; }
    .bg-soft-warning { background-color: #fffbeb; }
</style>
