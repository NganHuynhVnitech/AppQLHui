@model AppQLHui.Services.DashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-800 mb-0">Xin chào, Admin! 👋</h2>
            <p class="text-secondary">Hôm nay là @DateTime.Now.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("vi-VN"))</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Tontine" asp-action="Create" class="btn btn-gradient-success shadow-sm">
                <i class="bi bi-plus-lg"></i> Tạo Dây Hụi Mới
            </a>
        </div>
    </div>

    <!-- TỔNG QUAN STATS -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card stat-card-premium h-100">
                <div class="stat-label">DÂY HỤI ĐANG CHẠY</div>
                <div class="stat-value">@Model.RunningTontineCount</div>
                <div class="mt-2 small text-secondary">
                    <span class="text-success fw-bold">Active</span>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card-premium success h-100">
                <div class="stat-label">VỐN HỤI ĐANG QUAY</div>
                <div class="stat-value text-success">@Model.ActiveTontineCapital.ToString("N0") <small>đ</small></div>
                <div class="mt-2 small text-secondary">Tổng mệnh giá đang luân chuyển</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card-premium warning h-100">
                <div class="stat-label">THẢO HỤI (THÁNG NÀY)</div>
                <div class="stat-value text-warning">@Model.MonthlyFeesCollected.ToString("N0") <small>đ</small></div>
                <div class="mt-2 small text-secondary">Lợi nhuận tạm tính tháng @DateTime.Now.Month</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-card-premium danger h-100">
                <div class="stat-label">HỤI VIÊN</div>
                <div class="stat-value text-danger">@Model.TotalPlayers</div>
                <div class="mt-2 small text-secondary">Thành viên đăng ký</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- CẦN KHUI HÔM NAY -->
        <div class="col-lg-8">
            <div class="card h-100 shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>⚠️ DÂY HỤI CẦN KHUI HÔM NAY</span>
                    <span class="badge bg-warning">@Model.DueTodayTontines.Count</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Tên Dây</th>
                                    <th>Loại</th>
                                    <th>Mệnh Giá</th>
                                    <th class="text-end pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.DueTodayTontines.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-5 text-muted">
                                            <i class="bi bi-check-circle fs-1 d-block mb-2 text-success opacity-25"></i>
                                            Tuyệt vời! Không còn dây hụi nào bị trễ.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var t in Model.DueTodayTontines)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">@t.Name</td>
                                            <td><span class="badge bg-info">@t.Type</span></td>
                                            <td>@t.BaseAmount.ToString("N0") đ</td>
                                            <td class="text-end pe-4">
                                                <a asp-controller="Draw" asp-action="Index" asp-route-tontineId="@t.Id" 
                                                   class="btn btn-sm btn-primary px-3 shadow-sm rounded-pill">Khui Ngay</a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- THAO TÁC NHANH & BILL -->
        <div class="col-lg-4">
            <div class="card mb-4 shadow-sm border-0 bg-primary text-white">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">🚀 Truy cập nhanh</h5>
                    <div class="d-grid gap-2">
                        <a asp-controller="Draw" asp-action="Index" class="btn btn-light text-primary fw-bold border-0 shadow-sm">
                           🎯 KHUI HỤI (QUAY SỐ)
                        </a>
                        <a asp-controller="Player" asp-action="Create" class="btn btn-primary border border-white-50">
                           ➕ THÊM HỤI VIÊN
                        </a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    🎯 KỲ KHUI HÔM NAY
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (!Model.TodayDraws.Any())
                        {
                            <li class="list-group-item text-center py-4 text-muted small">
                                Chưa có kỳ khui nào được chốt.
                            </li>
                        }
                        else
                        {
                            @foreach (var d in Model.TodayDraws)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <div class="fw-bold">@d.Tontine.Name</div>
                                        <small class="text-muted">Kỳ #@d.SequenceNumber</small>
                                    </div>
                                    <a asp-controller="Draw" asp-action="Bill" asp-route-drawId="@d.Id" 
                                       class="btn btn-sm btn-outline-success border-0">
                                       <i class="bi bi-printer"></i> Bill
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
