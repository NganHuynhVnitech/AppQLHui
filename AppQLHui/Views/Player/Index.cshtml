<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-800 mb-0">👥 Danh Sách Hụi Viên</h2>
            <p class="text-secondary">Quản lý thông tin và lịch sử của tất cả thành viên</p>
        </div>
        <a asp-action="Create" class="btn btn-gradient-success px-4 shadow-sm rounded-pill">
            <i class="bi bi-person-plus me-1"></i> Thêm Hụi Viên Mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th class="ps-4 py-3">Hụi Viên</th>
                            <th>Số điện thoại</th>
                            <th>Tài khoản Zalo</th>
                            <th>Ngày tham gia</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3 bg-primary text-white">
                                            @p.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div class="fw-bold fs-6">@p.Name</div>
                                    </div>
                                </td>
                                <td><i class="bi bi-telephone text-secondary me-2"></i>@p.Phone</td>
                                <td>
                                    @if(!string.IsNullOrEmpty(p.ZaloName)) {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                            <i class="bi bi-chat-dots-fill me-1"></i>@p.ZaloName
                                        </span>
                                    } else {
                                        <span class="text-muted small">Chưa có</span>
                                    }
                                </td>
                                <td class="text-secondary">@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm rounded-pill overflow-hidden border">
                                        <a asp-controller="Report" asp-action="PlayerHistory" asp-route-playerId="@p.Id" 
                                           class="btn btn-sm btn-light px-3" title="Xem lịch sử">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@p.Id" 
                                           class="btn btn-sm btn-light px-3 text-warning" title="Sửa">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@p.Id" 
                                           class="btn btn-sm btn-light px-3 text-danger" title="Xoá">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px; height: 40px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1.1rem;
    }
    .bg-info-subtle { background-color: #e0f2fe; }
    .border-info-subtle { border-color: #bae6fd !important; }
</style>
