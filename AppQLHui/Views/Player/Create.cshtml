@model AppQLHui.Models.Player
@{
    ViewData["Title"] = "Thêm Hụi Viên";
}

<div class="animate-fade-in row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-800 mb-0">👥 Thêm Hụi Viên</h2>
                <p class="text-secondary">Đăng ký thành viên mới vào hệ thống</p>
            </div>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card shadow-lg border-0" style="border-radius: 24px;">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm" style="display:none"></div>
                    
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-secondary small text-uppercase">Họ và Tên</label>
                        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                            <span class="input-group-text border-0 bg-white text-primary"><i class="bi bi-person"></i></span>
                            <input asp-for="Name" class="form-control border-0 px-3" placeholder="Nguyễn Văn A" style="font-weight: 600;" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Phone" class="form-label fw-bold text-secondary small text-uppercase">Số điện thoại</label>
                        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                            <span class="input-group-text border-0 bg-white text-success"><i class="bi bi-telephone"></i></span>
                            <input asp-for="Phone" class="form-control border-0 px-3" placeholder="090 123 4567" style="font-weight: 600;" />
                        </div>
                    </div>

                    <div class="mb-5">
                        <label asp-for="ZaloName" class="form-label fw-bold text-secondary small text-uppercase">Tên Zalo (Nếu có)</label>
                        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                            <span class="input-group-text border-0 bg-white text-info"><i class="bi bi-chat-dots"></i></span>
                            <input asp-for="ZaloName" class="form-control border-0 px-3" placeholder="Zalo ID" style="font-weight: 600;" />
                        </div>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-lg btn-success rounded-pill px-5 py-3 shadow fw-800">
                            LƯU THÔNG TIN <i class="bi bi-check-lg ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-800 { font-weight: 800; }
</style>

@section Scripts { 
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
