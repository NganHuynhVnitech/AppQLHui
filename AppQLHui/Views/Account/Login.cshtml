@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập hệ thống";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QL HỤI PRO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 450px;
            border: none;
            border-radius: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
            background: white;
            overflow: hidden;
        }
        .login-header {
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            padding: 50px 30px;
            text-align: center;
            color: white;
        }
        .login-body {
            padding: 40px;
        }
        .form-control {
            border-radius: 15px;
            padding: 12px 20px;
            border: 2px solid #e2e8f0;
            transition: all 0.3s;
        }
        .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.25rem rgba(59, 130, 246, 0.1);
        }
        .btn-login {
            background: #2563eb;
            color: white;
            border-radius: 15px;
            padding: 12px;
            font-weight: 600;
            width: 100%;
            border: none;
            transition: all 0.3s;
        }
        .btn-login:hover {
            background: #1d4ed8;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(37, 99, 235, 0.3);
        }
        .animate-up {
            animation: slideUp 0.6s ease-out;
        }
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="login-card animate-up">
        <div class="login-header">
            <h2 class="fw-800 mb-1">QL HỤI PRO</h2>
            <p class="mb-0 opacity-75">Quản lý dây hụi thông minh & chuyên nghiệp</p>
        </div>
        <div class="login-body">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger rounded-4 border-0 mb-4 bg-danger bg-opacity-10 text-danger small">
                    <i class="bi bi-exclamation-circle me-2"></i> @ViewBag.Error
                </div>
            }
            
            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-person text-primary"></i>
                        </span>
                        <input type="text" name="username" class="form-control bg-light border-0 rounded-end-4" required placeholder="Nhập username...">
                    </div>
                </div>
                
                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 border-end-0 rounded-start-4 ps-3">
                            <i class="bi bi-lock text-primary"></i>
                        </span>
                        <input type="password" name="password" class="form-control bg-light border-0 rounded-end-4" required placeholder="Nhập password...">
                    </div>
                </div>
                
                <button type="submit" class="btn btn-login mb-3">ĐĂNG NHẬP NGAY</button>
                
                <div class="text-center mt-4">
                    <p class="text-muted small">Liên hệ quản trị viên nếu bạn quên mật khẩu.</p>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
