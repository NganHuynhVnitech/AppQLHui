@model AppQLHui.Models.Tontine
@{
    ViewData["Title"] = "Phân chia phần hụi";
    var players = (List<AppQLHui.Models.Player>)ViewBag.Players;
    int n = Model.TotalShares;
}

<div class="card">
    <div class="card-header fw-bold">
        🔢 Phân chia @n phần hụi cho dây: <strong>@Model.Name</strong>
        <small class="text-muted ms-2">(Mệnh giá: @Model.BaseAmount.ToString("N0")đ)</small>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <form asp-action="SetupShares" method="post">
            <input asp-for="Id" type="hidden" name="id" />
            <div class="alert alert-info">
                Chọn người chơi cho từng phần hụi. Mỗi người chơi có thể được chọn nhiều lần (cầm nhiều phần).
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3">
                @for (int i = 1; i <= n; i++)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 bg-light">
                            <div class="card-body p-2">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        @i
                                    </div>
                                    <span class="fw-bold small text-muted text-uppercase">Vị trí #@i</span>
                                </div>
                                <select name="player_@i" class="form-select border-0 shadow-none bg-white rounded-3 custom-select-premium" required>
                                    <option value="">-- Chọn hụi viên --</option>
                                    @foreach (var p in players)
                                    {
                                        <option value="@p.Id">@p.Name @(p.Phone != null ? $"({p.Phone})" : "")</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex gap-3 mt-5 pt-3 border-top justify-content-center">
                <button type="submit" class="btn btn-lg btn-gradient-success px-5 rounded-pill shadow">
                    <i class="bi bi-play-fill"></i> BẮT ĐẦU DÂY HỤI
                </button>
                <a asp-action="Index" class="btn btn-lg btn-light px-4 rounded-pill">Bỏ qua</a>
            </div>
        </form>
    </div>
</div>
