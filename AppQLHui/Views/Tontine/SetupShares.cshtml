@model AppQLHui.Models.Tontine
@{
    ViewData["Title"] = "Phân chia phần hụi";
    var players = (List<AppQLHui.Models.Player>)ViewBag.Players;
    int n = Model.TotalShares;
}

<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-800 mb-0">🔢 Phân chia hụi viên</h2>
            <p class="text-secondary">Dây hụi: <strong class="text-primary">@Model.Name</strong> | Mệnh giá: @Model.BaseAmount.ToString("N0")đ | @n phần</p>
        </div>
        <a asp-action="Index" class="btn btn-light rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Bỏ qua
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm border-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div>
    }

    <form asp-action="SetupShares" method="post" id="setupForm">
        <input asp-for="Id" type="hidden" name="id" />
        
        <!-- Hidden inputs to submit to controller -->
        <div id="hiddenInputsContainer">
            @for (int i = 1; i <= n; i++)
            {
                var share = Model.Shares.FirstOrDefault(s => s.Position == i);
                <input type="hidden" name="player_@i" id="hidden_@i" value="@(share?.PlayerId.ToString() ?? "")" />
            }
        </div>

        <div class="row g-4 h-100">
            <!-- LEFT PANE: Searchable Player List -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 20px;">
                    <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center" style="border-radius: 20px 20px 0 0;">
                        <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2"></i>Danh sách Hụi Viên</h5>
                        <button type="button" class="btn btn-sm btn-light rounded-circle shadow-sm" onclick="quickAddPlayer()" title="Thêm hụi viên nhanh">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                    <div class="card-body p-0 d-flex flex-column assign-pane">
                        <div class="p-3 border-bottom bg-light bg-opacity-50">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" id="searchInput" class="form-control border-start-0 ps-0 shadow-none" 
                                       placeholder="Tìm nhanh (nhấn F1)..." onkeyup="filterPlayers()" autocomplete="off">
                            </div>
                        </div>
                        <div class="list-group list-group-flush overflow-auto flex-grow-1 p-2" id="playerList">
                            @foreach (var p in players)
                            {
                                <button type="button" class="list-group-item list-group-item-action player-item border-0 rounded-3 mb-1" 
                                        data-id="@p.Id" data-name="@p.Name.Replace("'", "\\'")" onclick="assignPlayer(this)">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle-sm bg-primary-subtle text-primary fw-bold me-3">
                                            @p.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold player-name">@p.Name</div>
                                            <div class="small text-muted player-phone">@p.Phone</div>
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT PANE: Assign Slots -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm h-100" style="border-radius: 20px;">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold text-success"><i class="bi bi-diagram-3-fill me-2"></i>Vị trí trong dây hụi</h5>
                        <div class="badge bg-success-subtle text-success px-3 py-2 rounded-pill border border-success-subtle">
                            Đã xếp: <span id="filledCount" class="fw-bold">0</span> / @n
                        </div>
                    </div>
                    <div class="card-body p-4 overflow-auto assign-pane">
                        <div class="alert alert-info border-0 shadow-sm small py-2 d-flex align-items-center">
                            <i class="bi bi-info-circle-fill fs-5 me-2"></i> 
                            <span class="opacity-75">Bấm chọn người chơi ở cột trái để tự động xếp vào vị trí trống tiếp theo. Một hụi viên có thể lấy nhiều phần.</span>
                        </div>
                        
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mt-1 is-selectable">
                            @for (int i = 1; i <= n; i++)
                            {
                                var share = Model.Shares.FirstOrDefault(s => s.Position == i);
                                var isFilled = share != null;
                                
                                <div class="col">
                                    <div class="slot-card border rounded-4 p-3 h-100 d-flex flex-column justify-content-center text-center cursor-pointer @(isFilled ? "filled" : "empty")" 
                                         id="slot_@i" data-pos="@i" onclick="clearSlot(@i)">
                                        
                                        <!-- Empty State -->
                                        <div class="slot-empty text-muted @(isFilled ? "d-none" : "")">
                                            <div class="display-6 fw-800 opacity-25 mb-1">@i</div>
                                            <div class="small fw-bold text-uppercase">TRỐNG</div>
                                        </div>
                                        
                                        <!-- Filled State -->
                                        <div class="slot-filled @(isFilled ? "" : "d-none")">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div class="badge bg-primary rounded-pill px-2">Vị trí #@i</div>
                                                <i class="bi bi-x-circle text-danger fs-5 opacity-50 clear-icon hover-opacity-100"></i>
                                            </div>
                                            <div class="fw-bold fs-5 text-dark slot-player-name text-truncate">
                                                @(isFilled ? share.Player?.Name : "")
                                            </div>
                                        </div>
                                        
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-5 text-center d-flex justify-content-center gap-3">
            <button type="button" onclick="saveDraft()" class="btn btn-lg btn-outline-success rounded-pill px-5 shadow-sm fw-bold">
                 <i class="bi bi-save2-fill me-2"></i> LƯU NHÁP
            </button>
            <button type="button" onclick="submitForm()" class="btn btn-lg btn-success rounded-pill px-5 shadow fw-800">
                 BẮT ĐẦU DÂY HỤI <i class="bi bi-rocket-takeoff-fill ms-2"></i>
            </button>
        </div>
    </form>
</div>

<style>
    .avatar-circle-sm { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .player-item { transition: all 0.2s; }
    .player-item:hover { background-color: #eff6ff; transform: translateX(5px); }
    
    .slot-card { transition: all 0.3s; position: relative; background: #f8fafc; border: 2px dashed #cbd5e1 !important;}
    .slot-card.empty:hover { border-color: var(--primary) !important; background: white; }
    .slot-card.filled { border: 2px solid var(--success) !important; background: #f0fdf4; }
    .slot-card.filled:hover { border-color: var(--danger) !important; background: #fef2f2; }
    .hover-opacity-100 { transition: opacity 0.2s; }
    .slot-card:hover .hover-opacity-100 { opacity: 1 !important; }
    
    .assign-pane { height: 600px; }
    @@media (max-width: 992px) {
        .assign-pane { height: 400px; }
    }
    
    .fw-800 { font-weight: 800; }

    .cursor-pointer { cursor: pointer; }
</style>

@section Scripts {
    <script>
        const totalShares = @n;
        
        // F1 setup focus
        document.addEventListener('keydown', function(e) {
            if (e.key === 'F1') {
                e.preventDefault();
                document.getElementById('searchInput').focus();
            }
        });

        // Search filter logic
        function filterPlayers() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const items = document.querySelectorAll('.player-item');
            items.forEach(item => {
                const name = item.querySelector('.player-name').innerText.toLowerCase();
                const phone = item.querySelector('.player-phone').innerText.toLowerCase();
                if (name.includes(query) || phone.includes(query)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Logic to assign player to first empty slot
        function assignPlayer(element) {
            const playerId = element.getAttribute('data-id');
            const playerName = element.getAttribute('data-name');
            
            // Find first empty slot
            let assigned = false;
            for (let i = 1; i <= totalShares; i++) {
                const hiddenInput = document.getElementById('hidden_' + i);
                if (hiddenInput.value === '') {
                    // Found empty slot
                    hiddenInput.value = playerId;
                    
                    // Update UI
                    const slot = document.getElementById('slot_' + i);
                    slot.classList.remove('empty');
                    slot.classList.add('filled');
                    slot.querySelector('.slot-empty').classList.add('d-none');
                    slot.querySelector('.slot-filled').classList.remove('d-none');
                    slot.querySelector('.slot-player-name').innerText = playerName;
                    
                    updateCounter();
                    assigned = true;
                    
                    // Provide small visual feedback
                    slot.style.transform = "scale(1.05)";
                    setTimeout(() => slot.style.transform = "scale(1)", 200);
                    break;
                }
            }
            
            if (!assigned) {
                Swal.fire('Đã đủ phần!', 'Tất cả vị trí trong dây hụi đã được lấp đầy.', 'info');
            }
        }

        // Logic to clear a filled slot
        function clearSlot(i) {
            const hiddenInput = document.getElementById('hidden_' + i);
            if (hiddenInput.value === '') return; // Already empty
            
            // Clear input
            hiddenInput.value = '';
            
            // Update UI
            const slot = document.getElementById('slot_' + i);
            slot.classList.remove('filled');
            slot.classList.add('empty');
            slot.querySelector('.slot-empty').classList.remove('d-none');
            slot.querySelector('.slot-filled').classList.add('d-none');
            
            updateCounter();
        }
        
        function updateCounter() {
            let count = 0;
            for (let i = 1; i <= totalShares; i++) {
                if (document.getElementById('hidden_' + i).value !== '') count++;
            }
            document.getElementById('filledCount').innerText = count;
        }

        // Submit form
        function submitForm() {
            // Validate all filled
            for (let i = 1; i <= totalShares; i++) {
                if (document.getElementById('hidden_' + i).value === '') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Chưa đủ người',
                        text: `Vị trí #${i} chưa được phân công. Vui lòng xếp đủ ${totalShares} phần hụi để bắt đầu.`
                    });
                    return;
                }
            }
            
            document.getElementById('setupForm').action = "/Tontine/SetupShares";
            document.getElementById('setupForm').submit();
        }

        function saveDraft() {
            document.getElementById('setupForm').action = "/Tontine/SaveDraft";
            document.getElementById('setupForm').submit();
        }

        async function quickAddPlayer() {
            const { value: formValues } = await Swal.fire({
                title: 'Thêm hụi viên nhanh',
                html:
                    '<input id="swal-name" class="swal2-input" placeholder="Họ tên">' +
                    '<input id="swal-phone" class="swal2-input" placeholder="Số điện thoại">',
                focusConfirm: false,
                showCancelButton: true,
                cancelButtonText: 'Hủy',
                confirmButtonText: 'Lưu',
                preConfirm: () => {
                    return [
                        document.getElementById('swal-name').value,
                        document.getElementById('swal-phone').value
                    ]
                }
            });

            if (formValues) {
                const [name, phone] = formValues;
                if (!name) {
                    Swal.fire('Lỗi', 'Vui lòng nhập tên hụi viên', 'error');
                    return;
                }

                // Get Antiforgery Token
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

                try {
                    const response = await fetch('/Player/QuickCreate', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({
                            __RequestVerificationToken: token,
                            name: name,
                            phone: phone
                        })
                    });

                    const data = await response.json();
                    if (data.success) {
                        // Prepend to list
                        const playerList = document.getElementById('playerList');
                        const newItem = `
                            <button type="button" class="list-group-item list-group-item-action player-item border-0 rounded-3 mb-1 animate-fade-in" 
                                    data-id="${data.id}" data-name="${data.name.replace("'", "\\'")}" onclick="assignPlayer(this)">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle-sm bg-primary-subtle text-primary fw-bold me-3">
                                        ${data.avatarInit}
                                    </div>
                                    <div>
                                        <div class="fw-bold player-name">${data.name}</div>
                                        <div class="small text-muted player-phone">${data.phone}</div>
                                    </div>
                                </div>
                            </button>
                        `;
                        playerList.insertAdjacentHTML('afterbegin', newItem);
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: `Đã thêm ${data.name}`,
                            timer: 1500,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire('Lỗi', data.message || 'Không thể thêm hụi viên', 'error');
                    }
                } catch (error) {
                    Swal.fire('Lỗi', 'Có lỗi xảy ra khi kết nối server', 'error');
                }
            }
        }

        // Initialize state on load
        window.addEventListener('load', function() {
            updateCounter();
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
