@model AppQLHui.Models.Tontine
@{
    ViewData["Title"] = "Quản Lý " + Model.Name;
    var livingCount = Model.Shares.Count(s => s.Status == AppQLHui.Models.ShareStatus.Living);
    var deadCount = Model.Shares.Count(s => s.Status == AppQLHui.Models.ShareStatus.Dead);
    var progressPercent = (int)((double)deadCount / (Model.TotalShares > 0 ? Model.TotalShares : 1) * 100);
}

<div class="animate-fade-in">
    <!-- HEADER SECTION -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <nav aria-label="breadcrumb" class="mb-2">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-action="Index">Dây hụi</a></li>
                        <li class="breadcrumb-item active">@Model.Name</li>
                    </ol>
                </nav>
                <h1 class="fw-800 mb-0">@Model.Name</h1>
                <div class="d-flex align-items-center gap-3 mt-2">
                    @if (Model.Status == AppQLHui.Models.TontineStatus.Running) {
                        <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-play-circle-fill me-1"></i> ĐANG CHẠY</span>
                    } else if (Model.Status == AppQLHui.Models.TontineStatus.Completed) {
                        <span class="badge bg-dark rounded-pill px-3 py-2"><i class="bi bi-check-circle-fill me-1"></i> ĐÃ HOÀN TẤT</span>
                    } else if (Model.Status == AppQLHui.Models.TontineStatus.Disabled) {
                        <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-lock-fill me-1"></i> BỊ KHÓA</span>
                    } else {
                        <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-pencil-fill me-1"></i> BẢN NHÁP</span>
                    }
                    <span class="text-secondary small fw-bold text-uppercase tracking-widest">Chu kỳ: @Model.CycleType</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                 @if (Model.Status == AppQLHui.Models.TontineStatus.Running)
                {
                    <a asp-controller="Draw" asp-action="Index" asp-route-tontineId="@Model.Id" 
                       class="btn btn-premium btn-success px-4 shadow rounded-pill py-3">
                        <i class="bi bi-lightning-charge-fill me-2"></i> KHUI HỤI KỲ #@(Model.Draws.Count + 1)
                    </a>
                }
                <div class="dropdown">
                    <button class="btn btn-premium btn-warning px-4 shadow rounded-pill py-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-gear-wide-connected me-2"></i> CHỨC NĂNG
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="border-radius: 12px; min-width: 200px;">
                        <li><h6 class="dropdown-header small text-uppercase fw-bold">Quản trị dây hụi</h6></li>
                        <li><a class="dropdown-item rounded-3 py-2" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil-square me-2 text-primary"></i> Chỉnh sửa thông tin</a></li>
                        @if (Model.Status != AppQLHui.Models.TontineStatus.Completed)
                        {
                            <li>
                                <form asp-action="ToggleLock" asp-route-id="@Model.Id" method="post" id="lockForm">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="dropdown-item rounded-3 py-2 fw-bold @(Model.Status == AppQLHui.Models.TontineStatus.Disabled ? "text-success" : "text-warning")" 
                                            onclick="confirmToggleLock()">
                                        <i class="bi bi-lock@(Model.Status == AppQLHui.Models.TontineStatus.Disabled ? "-fill" : "") me-2"></i> 
                                        @(Model.Status == AppQLHui.Models.TontineStatus.Disabled ? "Mở khóa dây hụi" : "Khóa dây hụi")
                                    </button>
                                </form>
                            </li>
                        }
                        <li><button class="dropdown-item rounded-3 py-2 text-danger fw-bold" onclick="confirmDeleteTontine(@Model.Id)"><i class="bi bi-trash3 me-2"></i> Xóa dây hụi</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header small text-uppercase fw-bold">Báo cáo & In ấn</h6></li>
                        <li><button onclick="window.print()" class="dropdown-item rounded-3 py-2"><i class="bi bi-printer me-2"></i> In bảng kê danh sách</button></li>
                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Report" asp-action="TontineLedger" asp-route-id="@Model.Id"><i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i> Sổ nợ chi tiết dây</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm p-4 bg-gradient-primary text-white mb-4" style="border-radius: 24px;">
            <div class="row align-items-center">
                <div class="col-md-6 border-end border-white border-opacity-25">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="small opacity-75 text-uppercase fw-bold">Mệnh giá</div>
                            <h3 class="fw-800 mb-0 mt-1">@Model.BaseAmount.ToString("N0") <small class="fs-6">đ</small></h3>
                        </div>
                        <div class="col-6">
                            <div class="small opacity-75 text-uppercase fw-bold">Tiền thảo</div>
                            <h3 class="fw-800 mb-0 mt-1">@Model.CommissionFee.ToString("N0") <small class="fs-6">đ</small></h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 ps-md-5 mt-3 mt-md-0">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="small fw-bold text-uppercase">Tiến độ dây hụi</span>
                        <span class="small fw-bold">@deadCount / @Model.TotalShares (@progressPercent%)</span>
                    </div>
                    <div class="progress bg-white bg-opacity-25" style="height: 12px; border-radius: 6px;">
                        <div class="progress-bar bg-white shadow-sm" style="width: @progressPercent%; border-radius: 6px;"></div>
                    </div>
                    <div class="d-flex gap-4 mt-3 small opacity-75">
                        <span><i class="bi bi-circle-fill text-white small me-1"></i> @livingCount Phần sống</span>
                        <span><i class="bi bi-slash-circle-fill text-white small me-1"></i> @deadCount Phần chết</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- DETAILED SHARE TRACKER -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100 overflow-hidden" style="border-radius: 20px;">
                <div class="card-header bg-white py-4 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i>Danh Sách Thành Viên & Vị Trí</h5>
                        <p class="text-secondary small mb-0 mt-1">Theo dõi trạng thái từng phần hụi</p>
                    </div>
                    <div class="badge bg-light text-dark border p-2 px-3 rounded-pill fw-bold">
                        @Model.TotalShares / @Model.TotalShares PHẦN
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 py-3">VT</th>
                                    <th>Hội viên</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th class="text-center">Kỳ trúng</th>
                                    <th class="text-end pe-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Shares.OrderBy(s => s.Position))
                                {
                                    <tr class="@(s.Status == AppQLHui.Models.ShareStatus.Dead ? "opacity-75 bg-light" : "")">
                                        <td class="ps-4">
                                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center fw-bold text-secondary shadow-sm" style="width: 32px; height: 32px;">
                                                @s.Position
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-bold fs-6">@s.Player?.Name</div>
                                            <div class="small text-muted"><i class="bi bi-phone me-1"></i>@s.Player?.Phone</div>
                                        </td>
                                        <td class="text-center">
                                            @if (s.Status == AppQLHui.Models.ShareStatus.Living)
                                            {
                                                <span class="badge badge-soft-success rounded-pill px-3 py-2"><i class="bi bi-arrow-up-right-circle me-1"></i> SỐNG</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-danger rounded-pill px-3 py-2"><i class="bi bi-arrow-down-left-circle me-1"></i> CHẾT</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (s.WonDrawId.HasValue)
                                            {
                                                <span class="fw-bold text-secondary">KỲ #@s.WonDraw?.SequenceNumber</span>
                                                <div class="small text-muted">@s.WonDraw?.DrawDate.ToString("dd/MM/yy")</div>
                                            }
                                            else
                                            {
                                                <span class="text-muted opacity-50">-</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-light border rounded-pill px-2 shadow-xs" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2" style="border-radius: 12px; min-width: 200px;">
                                                    <li><h6 class="dropdown-header small text-uppercase fw-bold text-secondary">Phần hụi #@s.Position</h6></li>
                                                    <li>
                                                        <button class="dropdown-item rounded-3 py-2" onclick="openChangePlayerModal(@s.Id, @s.PlayerId, '@s.Player?.Name')">
                                                            <i class="bi bi-person-gear me-2 text-primary"></i> Đổi người chơi
                                                        </button>
                                                    </li>
                                                    @if (s.Status == AppQLHui.Models.ShareStatus.Dead && !s.IsSettledEarly)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item rounded-3 py-2 text-success fw-bold" onclick="settleShareEarly(@s.Id, '@s.Player?.Name')">
                                                                <i class="bi bi-cash-coin me-2"></i> Tất toán hụi chết
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (s.IsSettledEarly)
                                                    {
                                                        <li>
                                                            <span class="dropdown-item disabled text-success small">
                                                                <i class="bi bi-check-all me-2"></i> Đã tất toán sớm
                                                            </span>
                                                        </li>
                                                    }
                                                    @if (s.WonDrawId.HasValue)
                                                    {
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <a class="dropdown-item rounded-3 py-2" asp-controller="Report" asp-action="WinnerBill" asp-route-drawId="@s.WonDrawId">
                                                                <i class="bi bi-receipt me-2 text-secondary"></i> Xem hóa đơn
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- RECENT ACTIVITY / DRAW HISTORY -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100 overflow-hidden" style="border-radius: 20px;">
                <div class="card-header bg-white py-4 px-4 border-bottom">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-warning"></i>Nhật ký kỳ khui</h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.Draws.Any())
                    {
                        <div class="text-center py-5 px-4 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                            <p class="mb-0">Dây hụi vừa bắt đầu và chưa có kỳ khui nào diễn ra.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var d in Model.Draws.OrderByDescending(d => d.SequenceNumber))
                            {
                                <div class="list-group-item p-4 border-bottom-dashed">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="badge bg-primary-subtle text-primary border-0 rounded-pill px-3">Kỳ #@d.SequenceNumber</div>
                                        <div class="d-flex gap-2">
                                            <div class="small text-muted fw-bold">@d.DrawDate.ToString("dd/MM/yy")</div>
                                            <div class="dropdown no-print">
                                                <button class="btn btn-xs p-0 text-muted" type="button" data-bs-toggle="dropdown">
                                                    <i class="bi bi-three-dots"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                                                    <li>
                                                        <a class="dropdown-item rounded-2 py-2" asp-controller="Report" asp-action="WinnerBill" asp-route-drawId="@d.Id">
                                                            <i class="bi bi-printer me-2"></i> In lại hóa đơn
                                                        </a>
                                                    </li>
                                                    @if (d.SequenceNumber == Model.Draws.Max(x => x.SequenceNumber))
                                                    {
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <button class="dropdown-item rounded-2 py-2 text-danger fw-bold" onclick="deleteLatestDraw(@d.Id, @d.SequenceNumber)">
                                                                <i class="bi bi-trash3 me-2"></i> Xóa kỳ này
                                                            </button>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="fs-6 fw-bold text-dark mt-2">
                                        <i class="bi bi-trophy-fill text-warning me-2"></i> @d.WinningShare?.Player?.Name
                                    </div>
                                    <div class="mt-3 p-3 bg-light rounded-3 d-flex justify-content-between align-items-center">
                                        <div>
                                            <small class="text-secondary d-block">Tiền thăm kêu</small>
                                            <span class="fw-bold text-warning fs-5">@d.BidAmount.ToString("N0") <small class="fs-6">đ</small></span>
                                        </div>
                                        <a asp-controller="Report" asp-action="WinnerBill" asp-route-drawId="@d.Id" 
                                           class="btn btn-sm btn-white border shadow-xs rounded-pill">
                                           Chi tiết <i class="bi bi-chevron-right ms-1 small"></i>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="card-footer bg-light border-0 py-3 text-center">
                    <small class="text-secondary fw-bold">TỔNG THẢO THU ĐƯỢC: <span class="text-primary fs-6">@Model.TotalFeesCollected.ToString("N0") đ</span></small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge-soft-success { background-color: #ecfdf5; color: #059669; border: 1px solid #d1fae5; }
    .badge-soft-danger { background-color: #fef2f2; color: #dc2626; border: 1px solid #fee2e2; }
    .bg-gradient-primary { background: linear-gradient(135deg, #2563eb, #3b82f6); }
    .border-bottom-dashed { border-bottom: 2px dashed #f1f5f9; }
    .shadow-xs { box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .btn-white { background-color: white; color: #1e293b; }
    .tracking-widest { letter-spacing: 0.2em; }
    .btn-xs { padding: 1px 5px; font-size: 0.75rem; }
    
    @@media print {
        .navbar, .sidebar, .btn, .no-print, .breadcrumb, .dropdown { display: none !important; }
        .main-content { margin: 0 !important; padding: 0 !important; }
        .card { border: 1px solid #eee !important; box-shadow: none !important; }
        .bg-gradient-primary { background: #333 !important; color: white !important; }
    }
</style>

<!-- MODAL: ĐỔI NGƯỜI CHƠI -->
<div class="modal fade" id="changePlayerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 pb-0 ps-4 pt-4">
                <h5 class="fw-800"><i class="bi bi-person-gear me-2 text-primary"></i>Đổi Người Chơi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="changePlayerForm">
                <input type="hidden" name="shareId" id="modalShareId" />
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-secondary small mb-4">Nhường chân hụi đang thuộc về <strong id="modalCurrentName" class="text-dark"></strong> cho người chơi mới. Dòng tiền và lịch sử sẽ được bảo lưu.</p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn người chơi mới</label>
                        <select name="newPlayerId" id="modalNewPlayerId" class="form-select rounded-pill p-3 border-2 shadow-sm" required>
                            @foreach (var p in (List<AppQLHui.Models.Player>)ViewBag.AllPlayers)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow">Xác nhận thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function openChangePlayerModal(shareId, currentPlayerId, currentName) {
            $('#modalShareId').val(shareId);
            $('#modalCurrentName').text(currentName);
            $('#modalNewPlayerId').val(currentPlayerId);
            new bootstrap.Modal(document.getElementById('changePlayerModal')).show();
        }

        $('#changePlayerForm').on('submit', function(e) {
            e.preventDefault();
            const formData = $(this).serialize();
            
            fetch('/Tontine/ChangeSharePlayer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            })
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    Swal.fire('Thành công', res.message, 'success').then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            });
        });

        function settleShareEarly(shareId, playerName) {
            Swal.fire({
                title: 'Tất toán hụi chết sớm?',
                text: `Xác nhận người chơi ${playerName} đã nộp đủ tiền cục cho tất cả các kỳ còn lại của chân hụi này?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: '✅ Đúng, đã thu đủ tiền',
                cancelButtonText: 'Đóng'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    fetch('/Tontine/SettleShareEarly', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `shareId=${shareId}&__RequestVerificationToken=${token}`
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            Swal.fire('Thành công', res.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            });
        }

        function deleteLatestDraw(drawId, seqNo) {
            Swal.fire({
                title: `Xóa kỳ khui #${seqNo}?`,
                text: "Toàn bộ thống kê và công nợ của kỳ này sẽ bị hủy bỏ. Trạng thái người hốt sẽ được hoàn trả về 'Sống'.",
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: '🗑 Xóa ngay',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    fetch('/Draw/DeleteDraw', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: `drawId=${drawId}&__RequestVerificationToken=${token}`
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            Swal.fire('Đã xóa', res.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    });
                }
            });
        }

        function confirmDeleteTontine(id) {
            Swal.fire({
                title: 'Xóa toàn bộ dây hụi?',
                text: "Lưu ý: Hành động này sẽ xóa tất cả các kỳ khui, giao dịch và lịch sử liên quan. Bạn không thể hoàn tác!",
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: '🗑 Xóa vĩnh viễn',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Tontine/Delete/' + id;
                    const csrf = document.createElement('input');
                    csrf.type = 'hidden';
                    csrf.name = '__RequestVerificationToken';
                    csrf.value = token;
                    form.appendChild(csrf);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }

        function confirmToggleLock() {
            const isLocked = @(Model.Status == AppQLHui.Models.TontineStatus.Disabled ? "true" : "false");
            Swal.fire({
                title: isLocked ? 'Mở khóa dây hụi?' : 'Khóa dây hụi?',
                text: isLocked ? "Dây hụi sẽ hoạt động trở lại bình thường." : "Dây hụi sẽ không thể khui hụi cho đến khi được mở khóa.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: isLocked ? '#10b981' : '#f59e0b',
                confirmButtonText: isLocked ? '✅ Mở khóa' : '🔒 Khóa ngay',
                cancelButtonText: 'Để sau'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('lockForm').submit();
                }
            });
        }
    </script>
}
