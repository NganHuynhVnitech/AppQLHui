@model IEnumerable<AppQLHui.Models.Transaction>
@{
    ViewData["Title"] = "Biên Nhận Hốt Hụi";
    var draw = (AppQLHui.Models.Draw)ViewBag.Draw;
    var winnerTx = Model.FirstOrDefault(t => t.AmountReceive > 0);
}

<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <h2 class="fw-800 mb-0">🖨️ Biên Nhận Hốt Hụi</h2>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-printer me-1"></i> In Biên Nhận
            </button>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Quay lại</a>
        </div>
    </div>

    <!-- RECEIPT CONTENT -->
    <div class="card shadow-lg border-0 mb-5 p-4 p-md-5 bg-white" id="receipt-print">
        <!-- Header -->
        <div class="text-center mb-5 pb-4 border-bottom">
            <h1 class="fw-800 text-primary mb-1">BIÊN NHẬN GIAO HỤI</h1>
            <p class="text-secondary text-uppercase tracking-widest small">HỆ THỐNG QUẢN LÝ HỤI CHUYÊN NGHIỆP</p>
            <div class="mt-3">
                <span class="badge bg-primary px-3 py-2 fs-6">Kỳ #@draw.SequenceNumber</span>
                <span class="ms-2 text-secondary">Ngày khui: <strong>@draw.DrawDate.ToString("dd/MM/yyyy")</strong></span>
            </div>
        </div>

        <!-- Info Grid -->
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 h-100">
                    <label class="text-secondary small fw-bold text-uppercase d-block mb-1">Dây hụi</label>
                    <div class="fs-5 fw-bold">@draw.Tontine.Name</div>
                    <div class="text-muted small">Mệnh giá: @draw.Tontine.BaseAmount.ToString("N0") đ</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 bg-primary text-white rounded-3 h-100 shadow-sm">
                    <label class="opacity-75 small fw-bold text-uppercase d-block mb-1">Hụi viên hốt</label>
                    <div class="fs-4 fw-800">@draw.WinningShare?.Player?.Name</div>
                    <div class="opacity-75 small">SĐT: @draw.WinningShare?.Player?.Phone</div>
                </div>
            </div>
        </div>

        <!-- Financial Summary -->
        <div class="row g-3 mb-5">
            <div class="col-4">
                <div class="text-center">
                    <div class="text-secondary small fw-bold">TIỀN THĂM (B)</div>
                    <div class="fs-5 fw-bold text-warning">@draw.BidAmount.ToString("N0") <small>đ</small></div>
                </div>
            </div>
            <div class="col-4">
                <div class="text-center border-start border-end">
                    <div class="text-secondary small fw-bold">TIỀN THẢO (F)</div>
                    <div class="fs-5 fw-bold text-danger">@draw.CollectedFee.ToString("N0") <small>đ</small></div>
                </div>
            </div>
            <div class="col-4">
                <div class="text-center">
                    <div class="text-secondary small fw-bold">THỰC NHẬN</div>
                    <div class="fs-4 fw-800 text-success">@((winnerTx?.NetTotal ?? 0).ToString("N0")) <small>đ</small></div>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive mb-5">
            <table class="table table-sm align-middle">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-3 py-3">Danh sách thành viên</th>
                        <th class="text-end">Phải đóng</th>
                        <th class="text-end">Được nhận</th>
                        <th class="text-end pe-3">Net</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.OrderByDescending(t => t.AmountReceive))
                    {
                        var isWinner = tx.AmountReceive > 0;
                        <tr>
                            <td class="ps-3 py-3">
                                <div class="@(isWinner ? "fw-800 text-primary" : "fw-bold")">@tx.Player.Name @(isWinner ? "🏆" : "")</div>
                                <small class="text-muted">Cầm @tx.Draw.Tontine.Shares.Count(s => s.PlayerId == tx.PlayerId) phần</small>
                            </td>
                            <td class="text-end">@(tx.AmountPay > 0 ? tx.AmountPay.ToString("N0") : "-")</td>
                            <td class="text-end text-success fw-bold">@(tx.AmountReceive > 0 ? tx.AmountReceive.ToString("N0") : "-")</td>
                            <td class="text-end pe-3 @(tx.NetTotal >= 0 ? "text-success" : "text-danger") fw-bold">
                                @(tx.NetTotal >= 0 ? "+" : "")@tx.NetTotal.ToString("N0")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footnote / Signatures -->
        <div class="row mt-5 pt-5 text-center g-5">
            <div class="col-4">
                <div class="fw-bold mb-5 pb-3">Chủ Hụi</div>
                <div class="text-muted small mt-5">(Ký và ghi rõ họ tên)</div>
            </div>
            <div class="col-4">
                <!-- Spacer -->
            </div>
            <div class="col-4">
                <div class="fw-bold mb-5 pb-3">Người Nhận</div>
                <div class="text-muted small mt-5">(Ký và ghi rõ họ tên)</div>
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        header, .no-print, .btn { display: none !important; }
        body { background-color: white !important; margin: 0; padding: 0; }
        .card { box-shadow: none !important; border: none !important; padding: 0 !important; }
        #receipt-print { max-width: 100% !important; border: none !important; }
    }
    .tracking-widest { letter-spacing: 0.1em; }
</style>
