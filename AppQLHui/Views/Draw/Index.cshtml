@using AppQLHui.Models
@{
    ViewData["Title"] = "Điều hành Khui Hụi";
    var runningTontines = (List<Tontine>)ViewBag.RunningTontines;
    var selectedTontine = ViewBag.SelectedTontine as Tontine;
    var livingShares = ViewBag.LivingShares as List<TontineShare>;
}

@Html.AntiForgeryToken()

<div class="animate-fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-800 mb-0">🎯 Điều Hành Khui Hụi</h2>
        <div>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Làm mới</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- PANEL 1: Cấu hình kỳ khui -->
        <div class="col-lg-5">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-gear-fill me-2"></i>Cấu hình kỳ hốt</h5>
                </div>
                <div class="card-body">
                    <!-- Bước 1: Chọn dây -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">1. Chọn dây hụi</label>
                        <form method="get" asp-action="Index" id="tontineForm">
                            <select name="tontineId" class="form-select form-select-lg shadow-sm border-0 bg-light" 
                                    onchange="this.form.submit()" style="font-weight: 600;">
                                <option value="">-- Chọn dây đang chạy --</option>
                                @foreach (var t in runningTontines)
                                {
                                    <option value="@t.Id" selected="@(selectedTontine?.Id == t.Id ? "selected" : null)">
                                        @t.Name (@t.BaseAmount.ToString("N0")đ)
                                    </option>
                                }
                            </select>
                        </form>
                    </div>

                    @if (selectedTontine != null && livingShares != null)
                    {
                        <div class="alert alert-primary border-0 shadow-sm mb-4 d-flex align-items-center">
                            <div class="me-3 fs-3">ℹ️</div>
                            <div>
                                <div class="fw-bold fs-5">@selectedTontine.Name</div>
                                <div class="small opacity-75">
                                    Mệnh giá: @selectedTontine.BaseAmount.ToString("N0")đ | 
                                    Phần sống: <strong>@livingShares.Count</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Bước 2: Tiền thăm -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase">2. Tiền thăm kêu (Bid)</label>
                            <div class="input-group input-group-lg shadow-sm">
                                <span class="input-group-text border-0 bg-white text-success fw-bold">đ</span>
                                <input type="number" id="bidAmount" class="form-control border-0 px-3" 
                                       placeholder="0" value="0" min="0" max="@selectedTontine.BaseAmount" />
                            </div>
                            <div class="d-flex justify-content-between mt-1 px-1">
                                <small class="text-muted">Tối đa: @selectedTontine.BaseAmount.ToString("N0")đ</small>
                                <small class="text-primary cursor-pointer fw-bold" onclick="document.getElementById('bidAmount').value = 0">Reset</small>
                            </div>
                        </div>

                        <!-- Bước 3: Người hốt -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold text-secondary small text-uppercase mb-0">3. Chọn người hốt</label>
                                <button class="btn btn-sm btn-outline-warning border-0 fw-bold" onclick="randomDraw(@selectedTontine.Id)">
                                    🎲 Quay số ngẫu nhiên
                                </button>
                            </div>
                            <div class="share-grid-scroll p-2 bg-light rounded-3" style="max-height: 350px; overflow-y: auto;">
                                <div class="row row-cols-1 g-2">
                                    @foreach (var s in livingShares)
                                    {
                                        <div class="col">
                                            <div class="card share-item-premium border-0 shadow-sm" id="share-@s.Id" 
                                                 onclick="selectShare(@s.Id, '@s.Player.Name', @s.PlayerId)">
                                                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <div class="fw-bold mb-0">@s.Player.Name</div>
                                                        <div class="small text-muted">Vị trí #@s.Position | ID: @s.Id</div>
                                                    </div>
                                                    <div class="status-indicator"></div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-lg btn-primary w-100 shadow rounded-pill py-3 fw-800" onclick="previewDraw(@selectedTontine.Id)">
                            <i class="bi bi-calculator me-2"></i> XEM TOÁN TRƯỚC KHI CHỐT
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- PANEL 2: Kết quả & Preview -->
        <div class="col-lg-7">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-success"><i class="bi bi-receipt me-2"></i>Bảng tính toán chi tiết</h5>
                </div>
                <div class="card-body" id="previewPanel">
                    <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted py-5">
                        <i class="bi bi-pie-chart fs-1 mb-3 opacity-25"></i>
                        <p class="fs-5 fw-bold mb-0">Chưa có dữ liệu tính toán</p>
                        <p class="small text-center px-5">Vui lòng hoàn tất cấu hình bên trái và nhấn "Xem tính toán" để hiển thị bảng dòng tiền chi tiết cho kỳ hốt này.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header bg-success text-white border-0 py-3" style="border-radius: 20px 20px 0 0;">
                <h5 class="modal-title fw-bold">Xác nhận chốt kỳ hốt</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="confirmBody"></div>
            <div class="modal-footer border-0 p-3">
                <form asp-action="Execute" method="post" id="executeForm" class="w-100">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="tontineId" id="execTontineId" />
                    <input type="hidden" name="winningShareId" id="execShareId" />
                    <input type="hidden" name="bidAmount" id="execBidAmount" />
                    <input type="hidden" name="drawDate" id="execDrawDate" />
                    <div class="row g-2">
                        <div class="col-4">
                             <button type="button" class="btn btn-light w-100 rounded-pill" data-bs-dismiss="modal">Để sau</button>
                        </div>
                        <div class="col-8">
                            <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold">XÁC NHẬN CHỐT</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .share-item-premium { cursor: pointer; transition: all 0.2s; border: 2px solid transparent !important; }
    .share-item-premium:hover { transform: translateX(5px); background-color: #f8fafc; }
    .share-item-premium.selected { border-color: var(--success) !important; background-color: #ecfdf5; }
    .share-item-premium.selected .status-indicator { 
        width: 12px; height: 12px; background-color: var(--success); border-radius: 50%; box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.2); 
    }
    .fw-800 { font-weight: 800; }
    .cursor-pointer { cursor: pointer; }
</style>

@section Scripts {
<script>
    let selectedShareId = null;
    let selectedPlayerName = '';

    function selectShare(shareId, playerName, playerId) {
        document.querySelectorAll('.share-item-premium').forEach(el => el.classList.remove('selected'));
        document.getElementById('share-' + shareId)?.classList.add('selected');
        selectedShareId = shareId;
        selectedPlayerName = playerName;
    }

    function randomDraw(tontineId) {
        fetch(`/Draw/RandomDraw?tontineId=${tontineId}`)
            .then(r => r.json())
            .then(res => {
                if (res.success) {
                    selectShare(res.shareId, res.playerName, res.playerId);
                    const el = document.getElementById('share-' + res.shareId);
                    el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                    alert(res.message);
                }
            });
    }

    function previewDraw(tontineId) {
        if (!selectedShareId) { 
           Swal.fire('Thiếu thông tin', 'Vui lòng chọn hụi viên hốt kỳ này!', 'warning');
           return; 
        }
        const bid = parseFloat(document.getElementById('bidAmount').value) || 0;

        fetch('/Draw/Preview', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: `tontineId=${tontineId}&winningShareId=${selectedShareId}&bidAmount=${bid}`
        })
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                renderPreview(res.data, tontineId);
            } else {
                Swal.fire('Lỗi', res.message, 'error');
            }
        });
    }

    function renderPreview(data, tontineId) {
        let html = `
        <div class="animate-fade-in">
            <div class="row g-3 mb-4">
                <div class="col-4">
                    <div class="p-3 bg-light rounded-3 text-center border-start border-4 border-success">
                        <small class="text-secondary fw-bold d-block mb-1">GOM SỐNG</small>
                        <span class="fs-5 fw-800 text-success">${fmtNum(data.totalFromLiving)}</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-3 bg-light rounded-3 text-center border-start border-4 border-danger">
                        <small class="text-secondary fw-bold d-block mb-1">GOM CHẾT</small>
                        <span class="fs-5 fw-800 text-danger">${fmtNum(data.totalFromDead)}</span>
                    </div>
                </div>
                 <div class="col-4">
                    <div class="p-3 bg-primary rounded-3 text-center text-white shadow-sm">
                        <small class="fw-bold d-block mb-1 opacity-75">THỰC NHẬN</small>
                        <span class="fs-5 fw-800">${fmtNum(data.totalReceived)}</span>
                    </div>
                </div>
            </div>

            <div class="p-3 bg-light border-0 rounded-3 mb-4 small d-flex justify-content-between align-items-center">
                <span>Hụi viên hốt: <strong>${data.winnerPlayerName}</strong></span>
                <span>Tiền thăm: <strong class="text-warning">${fmtNum(data.bidAmount)} đ</strong></span>
                <span>Tiền thảo: <strong class="text-danger">${fmtNum(data.commissionFee)} đ</strong></span>
            </div>

            <div class="table-responsive rounded-3 border">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th class="ps-3 py-3">Danh sách hụi viên</th>
                            <th class="text-end">Phải đóng</th>
                            <th class="text-end">Được nhận</th>
                            <th class="text-end pe-3">Net (Thực thu)</th>
                        </tr>
                    </thead>
                    <tbody>`;

        data.playerTransactions.forEach(pt => {
            const netClass = pt.netTotal >= 0 ? 'text-success fw-bold' : 'text-danger fw-bold';
            const winnerIcon = pt.isWinner ? '<i class="bi bi-trophy-fill text-warning me-1"></i>' : '';
            html += `<tr class="${pt.isWinner ? 'bg-success bg-opacity-10' : ''}">
                <td class="ps-3">
                    <div class="fw-bold">${winnerIcon}${pt.playerName}</div>
                    <div class="small text-muted">Sống: ${pt.livingShareCount} | Chết: ${pt.deadShareCount}</div>
                </td>
                <td class="text-end">${pt.amountPay > 0 ? fmtNum(pt.amountPay) : '-'}</td>
                <td class="text-end text-success">${pt.amountReceive > 0 ? fmtNum(pt.amountReceive) : '-'}</td>
                <td class="text-end pe-3 ${netClass}">${pt.netTotal >= 0 ? '+' : ''}${fmtNum(pt.netTotal)}</td>
            </tr>`;
        });

        html += `</tbody></table></div>
            <div class="mt-4 text-end">
                <button class="btn btn-success btn-lg px-5 rounded-pill shadow fw-bold" 
                        onclick="confirmDraw(${tontineId}, ${data.winningShareId}, ${data.bidAmount}, '${data.winnerPlayerName.replace(/'/g, "\\'")}', ${data.totalReceived})">
                    ✅ CHỐT KỲ KHUI NÀY
                </button>
            </div>
        </div>`;

        document.getElementById('previewPanel').innerHTML = html;
        document.getElementById('previewPanel').scrollIntoView({ behavior: 'smooth' });
    }

    function confirmDraw(tontineId, shareId, bid, winner, total) {
        document.getElementById('execTontineId').value = tontineId;
        document.getElementById('execShareId').value = shareId;
        document.getElementById('execBidAmount').value = bid;
        document.getElementById('execDrawDate').value = new Date().toISOString();
        
        document.getElementById('confirmBody').innerHTML = `
            <div class="text-center mb-4">
                <i class="bi bi-question-circle font-primary" style="font-size: 4rem; color: #10b981;"></i>
                <h4 class="fw-800">Xác nhận giao hụi?</h4>
                <p class="text-secondary">Vui lòng kiểm tra kỹ hụi viên hốt và tiền thăm trước khi chốt. Thao tác không thể hoàn tác.</p>
            </div>
            <div class="p-3 bg-light rounded-3">
                <div class="d-flex justify-content-between mb-2">
                    <span>Hụi viên nhận:</span>
                    <strong class="text-primary">${winner}</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Tiền thăm đặt:</span>
                    <strong class="text-warning">${fmtNum(bid)} đ</strong>
                </div>
                <div class="d-flex justify-content-between fs-5 pt-2 border-top">
                    <span>Tổng tiền giao hụi:</span>
                    <strong class="text-success">${fmtNum(total)} đ</strong>
                </div>
            </div>`;
            
        new bootstrap.Modal(document.getElementById('confirmModal')).show();
    }

    function fmtNum(n) {
        return Math.round(n).toLocaleString('vi-VN');
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
