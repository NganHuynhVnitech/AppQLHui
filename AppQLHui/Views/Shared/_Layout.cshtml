<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - App Hụi Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        @@media print { .no-print { display: none !important; } .card { box-shadow: none !important; border: 1px solid #eee !important; } }
        .navbar-dark .navbar-nav .nav-link { color: rgba(255,255,255,0.7); font-weight: 500; transition: color 0.2s; }
        .navbar-dark .navbar-nav .nav-link:hover { color: #fff; }
        .navbar-dark .navbar-nav .nav-link.active { color: #fff; font-weight: 700; }
    </style>
</head>
<body>
<header class="navbar navbar-expand-sm navbar-dark bg-dark no-print">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            🎰 QL Hụi Pro
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">📊 Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Player" asp-action="Index">👥 Hụi viên</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Tontine" asp-action="Index">📋 Dây hụi</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Draw" asp-action="Index">🎯 Khui hụi</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Report" asp-action="Index">📈 Báo cáo</a></li>
            </ul>
        </div>
    </div>
</header>
<div class="container-fluid">
    <div class="row">
        <main class="col py-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show no-print" role="alert">
                    ✅ @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show no-print" role="alert">
                    ❌ @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>
<footer class="border-top text-muted py-2 text-center small no-print">
    &copy; 2026 - Phần mềm Quản lý Hụi Pro
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
