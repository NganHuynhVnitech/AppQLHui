<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - App Hụi Pro</title>
    <!-- BOOTSTRAP 5 & ICONS FROM CDN - Fix for missing local lib -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- GOOGLE FONTS: INTER -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- SIDEBAR -->
        <aside class="sidebar no-print">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-slot-machine-fill text-primary fs-3"></i>
                <span>QL HỤI PRO</span>
            </a>
            
            <nav class="nav-menu">
                <a class="nav-link-premium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" 
                   asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>
                
                <a class="nav-link-premium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Player" ? "active" : "")" 
                   asp-controller="Player" asp-action="Index">
                    <i class="bi bi-people-fill"></i> Hụi Viên
                </a>
                
                <a class="nav-link-premium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tontine" ? "active" : "")" 
                   asp-controller="Tontine" asp-action="Index">
                    <i class="bi bi-clipboard-data-fill"></i> Dây Hụi
                </a>
                
                <a class="nav-link-premium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Draw" ? "active" : "")" 
                   asp-controller="Draw" asp-action="Index">
                    <i class="bi bi-bullseye"></i> Khui Hụi
                </a>
                
                <a class="nav-link-premium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                   asp-controller="Report" asp-action="Index">
                    <i class="bi bi-graph-up-arrow"></i> Báo Cáo
                </a>
                
                <a class="nav-link-premium @(ViewContext.RouteData.Values["action"]?.ToString() == "UnpaidDebts" ? "active" : "")" 
                   asp-controller="Report" asp-action="UnpaidDebts">
                    <i class="bi bi-journal-x"></i> Sổ Nợ / Chưa Thu
                </a>
                
                <a class="nav-link-premium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Zalo" ? "active" : "")" 
                   asp-controller="Zalo" asp-action="Index">
                    <i class="bi bi-chat-dots-fill"></i> Cấu hình Zalo
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <div class="px-3 mt-4 mb-2 small text-uppercase text-secondary fw-bold opacity-50">Hệ thống</div>
                    <a class="nav-link-premium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")" 
                       asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-shield-lock-fill"></i> Quản trị User
                    </a>
                }
            </nav>
            
            <div class="mt-auto p-3 border-top bg-light">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; flex-shrink: 0;">
                            @User.Identity?.Name?.Substring(0, 1).ToUpper()
                        </div>
                        <div class="text-truncate">
                            <div class="fw-bold small text-dark">@User.Identity?.Name</div>
                            <div class="text-muted" style="font-size: 0.65rem;">@User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</div>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="no-print">
                        <button type="submit" class="btn btn-link p-0 text-danger border-0">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
                <div class="d-flex align-items-center gap-2" style="font-size: 0.75rem;">
                    <div class="rounded-circle bg-success shadow-sm" style="width: 8px; height: 8px;"></div>
                    <span class="text-muted">Hệ thống trực tuyến</span>
                </div>
            </div>
        </aside>

        <!-- MOBILE TOGGLE (Logic can be added via JS) -->
        <button class="btn btn-primary btn-mobile-toggle no-print" type="button" id="sidebarToggle">
            <i class="bi bi-list"></i>
        </button>

        <!-- MAIN VIEW -->
        <main class="main-content">
            <div class="container-fluid">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show no-print shadow-sm border-0 mb-4 animate-fade-in" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show no-print shadow-sm border-0 mb-4 animate-fade-in" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                
                @RenderBody()
                
                <footer class="border-top mt-5 pt-4 text-muted small no-print text-center opacity-75">
                    &copy; 2026 - <strong>Phần mềm Quản lý Hụi Pro</strong> - <span class="badge bg-secondary opacity-50">v1.2</span>
                </footer>
            </div>
        </main>
    </div>

    <!-- SCRIPTS VIA CDN - Fix for missing local lib -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <script>
        $(document).ready(function() {
            $('#sidebarToggle').on('click', function() {
                $('.sidebar').toggleClass('show');
            });
        });
    </script>
</body>
</html>
