@model IEnumerable<AppQLHui.Models.AppUser>
@{
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-800 text-primary mb-1">Quản lý Người dùng</h2>
        <p class="text-muted small mb-0">Hệ thống phân quyền Admin & Chủ hụi</p>
    </div>
    <button class="btn btn-primary rounded-4 px-4 py-2 shadow-sm fw-600" data-bs-toggle="modal" data-bs-target="#createUserModal">
        <i class="bi bi-person-plus-fill me-2"></i> THÊM TÀI KHOẢN
    </button>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-5 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase fw-bold">
                        <tr>
                            <th class="ps-4 py-3">Người dùng</th>
                            <th class="py-3">Tên đăng nhập</th>
                            <th class="py-3">Vai trò</th>
                            <th class="py-3">Trạng thái</th>
                            <th class="py-3">Ngày tạo</th>
                            <th class="py-3 text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle @(user.IsEnabled ? "bg-primary" : "bg-secondary") bg-opacity-10 @(user.IsEnabled ? "text-primary" : "text-secondary") d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                            @user.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold @(user.IsEnabled ? "" : "text-decoration-line-through text-muted")">@user.FullName</div>
                                            <div class="text-muted small">ID: @user.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark rounded-pill px-3">@user.Username</span></td>
                                <td>
                                    @if (user.Role == AppQLHui.Models.UserRole.Admin)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-4">
                                            <i class="bi bi-shield-lock me-1"></i> ADMIN
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-4">
                                            <i class="bi bi-person-badge me-1"></i> CHỦ HỤI
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsEnabled)
                                    {
                                        <span class="badge bg-success border-0 rounded-circle p-1" title="Đang hoạt động" style="width: 10px; height: 10px; display: inline-block;"></span>
                                        <small class="text-success ms-1">Hoạt động</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger border-0 rounded-circle p-1" title="Bị khóa" style="width: 10px; height: 10px; display: inline-block;"></span>
                                        <small class="text-danger ms-1">Bị khóa</small>
                                    }
                                </td>
                                <td class="small text-muted">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end pe-4">
                                    @if (user.Username != "admin")
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-3 px-3 me-1" 
                                                data-bs-toggle="modal" data-bs-target="#editUserModal" 
                                                data-id="@user.Id" data-fullname="@user.FullName" data-role="@user.Role">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </button>

                                        <form asp-action="ResetPassword" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn muốn reset mật khẩu của @user.FullName về mặc định (123456)?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-info btn-sm rounded-3 px-3 me-1" title="Đặt mật khẩu mặc định (123456)">
                                                <i class="bi bi-key-fill"></i> Reset
                                            </button>
                                        </form>

                                        <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn @(user.IsEnabled ? "btn-outline-warning" : "btn-outline-success") btn-sm rounded-3 px-3 me-1">
                                                <i class="bi @(user.IsEnabled ? "bi-lock-fill" : "bi-unlock-fill")"></i>
                                                @(user.IsEnabled ? "Khóa" : "Mở")
                                            </button>
                                        </form>

                                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn chắc chắn muốn xóa tài khoản này? Toàn bộ dữ liệu của user sẽ bị ẩn/xóa.')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-3">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Create User -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-5">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-800">Thêm người dùng mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ tên chủ hụi</label>
                        <input type="text" name="fullName" class="form-control rounded-4 px-3" placeholder="Nguyễn Văn A..." required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập (Username)</label>
                        <input type="text" name="username" class="form-control rounded-4 px-3" placeholder="huyvien_a..." required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu</label>
                        <input type="password" name="password" class="form-control rounded-4 px-3" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Vai trò</label>
                        <select name="role" class="form-select rounded-4 px-3">
                            <option value="Owner">Chủ hụi (Owner)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 p-4">
                    <button type="button" class="btn btn-light rounded-4 px-4" data-bs-dismiss="modal">HỦY</button>
                    <button type="submit" class="btn btn-primary rounded-4 px-4 shadow">TẠO TÀI KHOẢN</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit User -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-5">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-800">Cập nhật người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="EditUser" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit-id">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ tên chủ hụi</label>
                        <input type="text" name="fullName" id="edit-fullname" class="form-control rounded-4 px-3" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Vai trò</label>
                        <select name="role" id="edit-role" class="form-select rounded-4 px-3">
                            <option value="Owner">Chủ hụi (Owner)</option>
                            <option value="Admin">Quản trị viên (Admin)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 p-4">
                    <button type="button" class="btn btn-light rounded-4 px-4" data-bs-dismiss="modal">HỦY</button>
                    <button type="submit" class="btn btn-primary rounded-4 px-4 shadow">CẬP NHẬT</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editUserModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var fullname = button.getAttribute('data-fullname');
            var role = button.getAttribute('data-role');

            document.getElementById('edit-id').value = id;
            document.getElementById('edit-fullname').value = fullname;
            document.getElementById('edit-role').value = role;
        });
    </script>
}
